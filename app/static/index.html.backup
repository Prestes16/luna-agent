            <div class="sec-head">
              <span class="sec-label">// aprovação pendente</span>
              <div class="sec-rule"></div>
              <button class="img-action-btn" id="refreshQueueBtn" style="flex-shrink:0">↻</button>
            </div>
            <div class="queue-section" id="pendingQueue">
              <div class="queue-empty">Nenhuma ação aguardando aprovação.</div>
            </div>
          </div>

          <!-- QUEUE: AUTOMÁTICO -->
          <div>
            <div class="sec-head"><span class="sec-label">// execução automática</span><div class="sec-rule"></div></div>
            <div class="queue-section" id="autoQueue">
              <div class="queue-empty">Nenhuma ação de execução automática.</div>
            </div>
          </div>

          <!-- LAST RESULT -->
          <div>
            <div class="sec-head"><span class="sec-label">// último resultado</span><div class="sec-rule"></div></div>
            <div class="agent-result-box" id="agentResultBox">Aguardando execução...</div>
          </div>

          <!-- WORKER STATUS -->
          <div id="workerStatusSection">
            <div class="sec-head">
              <span class="sec-label">// worker local</span>
              <div class="sec-rule"></div>
              <button class="img-action-btn" id="refreshWorkerBtn" style="flex-shrink:0">↻</button>
            </div>
            <div id="workerStatusCard" style="padding:10px 14px;border:1px solid var(--line);border-radius:var(--rb);font-family:var(--mono);font-size:11px;color:var(--muted);line-height:1.8">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                <span class="bridge-dot" id="workerDot"></span>
                <span id="workerStatusText" style="font-size:12px;color:var(--text)">Verificando...</span>
                <span id="workerVersionTag" style="font-size:9px;color:var(--dim);margin-left:auto;font-family:var(--mono)"></span>
              </div>
              <div id="workerMetaGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:2px 16px">
                <span>Hostname: <span id="wHostname" style="color:var(--sky)">—</span></span>
                <span>Heartbeat: <span id="wHeartbeat" style="color:var(--sky)">—</span></span>
                <span>Capabilities: <span id="wCaps" style="color:var(--sky)">—</span></span>
                <span>Dirs: <span id="wDirs" style="color:var(--sky)">—</span></span>
              </div>
              <div id="workerOfflineHint" style="margin-top:8px;display:none">
                <span style="color:var(--amber)">⚠ Worker offline.</span>
                <span style="color:var(--dim)"> Inicie com: <code style="color:var(--cyan)">python luna_worker.py</code></span>
              </div>
            </div>
          </div>

          <!-- WORKER TASKS -->
          <div id="workerTasksSection">
            <div class="sec-head">
              <span class="sec-label">// tarefas do worker</span>
              <div class="sec-rule"></div>
              <button class="img-action-btn" id="refreshWorkerTasksBtn" style="flex-shrink:0">↻</button>
            </div>
            <div class="audit-list" id="workerTasksList">
              <div class="queue-empty">Sem tarefas do worker.</div>
            </div>
          </div>

          <!-- STATE DISPLAY -->
          <div>
            <div class="sec-head">
              <span class="sec-label">// estado do sistema</span>
              <div class="sec-rule"></div>
              <button class="img-action-btn" id="loadAgentStateBtn" style="flex-shrink:0">↻ estado</button>
            </div>
            <div class="agent-result-box" id="agentStateDisplay" style="max-height:160px">Carregando...</div>
          </div>

          <!-- AUDIT LOG -->
          <div>
            <div class="sec-head">
              <span class="sec-label">// auditoria</span>
              <div class="sec-rule"></div>
              <button class="img-action-btn" id="refreshAuditBtn" style="flex-shrink:0">↻</button>
            </div>
            <div class="audit-list" id="auditList">
              <div class="queue-empty">Sem entradas de auditoria.</div>
            </div>
          </div>

          <!-- SCREEN OBSERVATION -->
          <div class="screen-observe" id="screenObserveSection">
            <div class="screen-observe-header">
              <span class="screen-observe-title">// observação local</span>
              <div class="screen-observe-actions">
                <span id="screenTargetBadge" style="font-family:var(--mono);font-size:10px;color:var(--muted)">alvo: VPS</span>
                <button class="img-action-btn" id="captureScreenBtn" disabled>📷 Capturar tela</button>
                <button class="img-action-btn" id="analyzeScreenBtn" style="display:none">🔍 Analisar</button>
              </div>
            </div>

            <div class="screen-meta" id="screenMeta">
              <span>status: <span id="smBridge" style="color:var(--dim)">bridge offline</span></span>
              <span>último: <span id="smTs" style="color:var(--dim)">—</span></span>
              <span>resolução: <span id="smRes" style="color:var(--dim)">—</span></span>
              <span>tamanho: <span id="smSize" style="color:var(--dim)">—</span></span>
            </div>

            <div class="screen-preview-wrap" id="screenPreviewWrap">
              <div class="screen-preview-empty" id="screenPreviewEmpty">Nenhuma captura ainda · ative o modo LOCAL e clique "Capturar tela"</div>
              <img class="screen-preview-img" id="screenPreviewImg" src="" alt="captura de tela" style="display:none">
              <div class="screen-preview-overlay" id="screenPreviewOverlay" style="display:none">
                <span id="screenOverlayTs"></span>
                <span id="screenOverlayRes"></span>
              </div>
            </div>

            <div class="screen-analysis-box" id="screenAnalysisBox">
              <div class="screen-analysis-label">// análise visual · gpt-4o</div>
              <div id="screenAnalysisText"></div>
            </div>
          </div>

        </div>
      </div><!-- /panel-agent -->

      <!-- FOOTER -->
      <div class="footer-bar">
        <div class="footer-pills">
          <span class="fpill active">TEXTO</span>
          <span class="fpill">VOZ</span>
          <span class="fpill">AGENTE</span>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
          <span class="phase-badge">FASE 2</span>
          <div class="footer-stack">STACK: <span id="ui-stack">FastAPI · Docker · GPT-4o</span></div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
/* ══════════════════════════════════════════════
   CONFIG — plugável + localStorage
══════════════════════════════════════════════ */
const DEFAULTS = {
  name:        'Luna',
  tagline:     'assistente operacional · engenharia · automação · segurança',
  endpoint:    '/chat',
  method:      'POST',
  field:       'message',
  respPath:    'response.text',
  headers:     '',
  project:     'luna-agent',
  mission:     'Execução assistida e rastreabilidade real',
  stack:       'FastAPI · Docker · GPT-4o',
  placeholder: 'Ex.: Luna, qual o próximo passo da missão?'
};

let CFG = { ...DEFAULTS };

function loadConfig() {
  const saved = localStorage.getItem('luna_cfg');
  if (saved) {
    try { CFG = { ...DEFAULTS, ...JSON.parse(saved) }; } catch(e) { CFG = { ...DEFAULTS }; }
  }
  const savedMode = localStorage.getItem('luna_current_mode');
  if (savedMode) {
    currentMode = savedMode;
    document.querySelectorAll('.mode-tab').forEach(t => {
      if (t.dataset.mode === currentMode) t.classList.add('active');
      else t.classList.remove('active');
    });
    const statMode = document.getElementById('stat-mode');
    if (statMode) {
      statMode.textContent = currentMode.toUpperCase();
      statMode.style.color = currentMode === 'dev' ? 'var(--cyan)' : currentMode === 'hunter' ? 'var(--amber)' : 'var(--sky)';
    }
  }
  applyConfigUI();
}

function applyConfigUI() {
  document.getElementById('ui-name').innerText        = CFG.name;
  document.querySelector('.tagline').innerHTML        = `// ${CFG.tagline}`;
  // ui-project is managed by loadWorkspaces() — don't overwrite here
  document.getElementById('ui-mission').innerText     = CFG.mission;
  document.getElementById('ui-stack').innerText       = CFG.stack;
  document.getElementById('msgInput').placeholder     = CFG.placeholder;
  document.getElementById('ui-chat-title').innerText  = `${CFG.name} · Chat direto`;
  document.getElementById('modelLabel').innerText     = 'LUNA v1 · FASE 2';
}

/* ══════════════════════════════════════════════
   SESSION & MODE
══════════════════════════════════════════════ */
const SESSION_KEY = 'luna_chat_session_id';
let currentSessionId = localStorage.getItem(SESSION_KEY) || '';
let currentMode      = 'dev';

function setSessionId(id) {
  currentSessionId = (id || '').trim();
  if (currentSessionId) localStorage.setItem(SESSION_KEY, currentSessionId);
}

function resetChatSession() {
  localStorage.removeItem(SESSION_KEY);
  currentSessionId = '';

  chatMsgs.querySelectorAll('.msg, #typingRow, #typing-ind').forEach(el => el.remove());

  if (emptyState) {
    emptyState.style.display = '';
  }

  msgInput.value = '';
  msgInput.style.height = 'auto';
  charCount.textContent = '';
  msgInput.focus();
}

/* ══════════════════════════════════════════════
   DOM REFS
══════════════════════════════════════════════ */
const msgInput      = document.getElementById('msgInput');
const sendBtn       = document.getElementById('sendBtn');
const sendSpinner   = document.getElementById('sendSpinner');
const chatMsgs      = document.getElementById('chatMsgs');
const emptyState    = document.getElementById('emptyState');
const charCount     = document.getElementById('charCount');
const drawer        = document.getElementById('drawer');
const overlay       = document.getElementById('overlay');
const toast         = document.getElementById('toast');
const newSessionBtn = document.getElementById('newSessionBtn');

/* ══════════════════════════════════════════════
   UTILS
══════════════════════════════════════════════ */
function showToast(msg) {
  const t = document.getElementById('toast');
  if (!t) return;
  t.textContent = msg || '✓';
  t.classList.add('show');
  clearTimeout(t._toastTimer);
  t._toastTimer = setTimeout(() => t.classList.remove('show'), 3500);
}

function deepGet(obj, path) {
  if (!path) return undefined;
  return path.split('.').reduce((acc, part) => acc && acc[part], obj);
}

/* ──────────────────────────────────────────────
   BUG FIX: buildHistoryPayload
   - filtra elementos sem .msg-bubble (typing row)
   - usa filter(Boolean) para ignorar nulls
────────────────────────────────────────────── */
function buildHistoryPayload(limit = 8) {
  const history = Array.from(chatMsgs.querySelectorAll('.msg'))
    .map(b => {
      const bubble = b.querySelector('.msg-bubble');
      if (!bubble) return null;

      return {
        role:    b.classList.contains('user') ? 'user' : 'assistant',
        content: bubble.innerText
      };
    })
    .filter(Boolean);

  return history.slice(-limit);
}

/* ══════════════════════════════════════════════
   MESSAGES
══════════════════════════════════════════════ */
function appendMsg(who, text, safeMode = false) {
  if (emptyState) emptyState.style.display = 'none';

  const msg = document.createElement('div');
  msg.className = `msg ${who}${safeMode ? ' safe' : ''}`;
  msg.innerHTML = `
    <span class="msg-who">${who === 'user' ? 'Você' : CFG.name}</span>
    <div class="msg-bubble">${escapeHtml(text)}</div>
  `;
  chatMsgs.appendChild(msg);
  chatMsgs.scrollTop = chatMsgs.scrollHeight;
  return msg;
}

function escapeHtml(s) {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\n/g, '<br>');
}

function showTyping() {
  if (document.getElementById('typingRow')) return;
  const row = document.createElement('div');
  row.id        = 'typingRow';
  row.className = 'msg agent';
  row.innerHTML = `
    <span class="msg-who">${CFG.name}</span>
    <div class="typing-row">
      <div class="tdot"></div>
      <div class="tdot"></div>
      <div class="tdot"></div>
    </div>
  `;
  chatMsgs.appendChild(row);
  chatMsgs.scrollTop = chatMsgs.scrollHeight;
}

function removeTyping() {
  const row = document.getElementById('typingRow');
  if (row) row.remove();
}

/* ══════════════════════════════════════════════
   SEND MESSAGE — BUG FIX: showTyping() movido
   para DEPOIS do buildHistoryPayload()
══════════════════════════════════════════════ */
async function sendMessage() {
  const text = msgInput.value.trim();
  if (!text) return;

  appendMsg('user', text);
  msgInput.value = '';
  msgInput.style.height = 'auto';
  charCount.textContent = '';
  sendBtn.disabled = true;
  sendSpinner.classList.add('show');

  let extraHeaders = {};
  try {
    if (CFG.headers.trim()) extraHeaders = JSON.parse(CFG.headers);
  } catch {}

  const payload = { [CFG.field]: text };

  if (CFG.method !== 'GET' && (CFG.endpoint === '/chat' || CFG.field === 'message')) {
    payload.history  = buildHistoryPayload(8);
    payload.mode     = currentMode;
    if (currentSessionId) payload.session_id = currentSessionId;
  }

  showTyping();

  try {
    const res  = await fetch(CFG.endpoint, {
      method:  CFG.method,
      headers: { 'Content-Type': 'application/json', ...extraHeaders },
      body:    CFG.method !== 'GET' ? JSON.stringify(payload) : undefined,
    });

    removeTyping();

    let data;
    try { data = await res.json(); } catch(_) { data = {}; }

    const returnedSession =
      deepGet(data, 'response.session_id') ||
      data.session_id || '';
    if (returnedSession) setSessionId(returnedSession);

    if (!res.ok) {
      // Erro real do backend — diferenciado visualmente, não parece resposta da Luna
      const errDetail = data.detail || `HTTP ${res.status}`;
      const el = appendMsg('agent', `Erro do sistema: ${errDetail}`, false);
      el.classList.add('error');
    } else {
      const safeMode = data.safe_mode === true;
      const answer = deepGet(data, CFG.respPath) || 'Sem resposta.';
      appendMsg('agent', answer, safeMode);
      speakAsLuna(answer);
    }

  } catch (err) {
    removeTyping();
    const el = appendMsg('agent', `Erro de conexão: ${err.message}`, false);
    el.classList.add('error');
  } finally {
    sendBtn.disabled = false;
    sendSpinner.classList.remove('show');
    msgInput.focus();
  }
}

/* ══════════════════════════════════════════════
   TTS — VOZ
══════════════════════════════════════════════ */
async function speakAsLuna(text) {
  const voiceActive = document.querySelector('.fpill:nth-child(2)');
  if (!voiceActive || !voiceActive.classList.contains('active')) return;
  try {
    const res = await fetch('/speak', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ text })
    });
    if (!res.ok) return;
    const blob = await res.blob();
    const url  = URL.createObjectURL(blob);
    new Audio(url).play();
  } catch(e) {}
}

/* ══════════════════════════════════════════════
   MODE TABS
══════════════════════════════════════════════ */
document.getElementById('chatModes').addEventListener('click', e => {
  const tab = e.target.closest('.mode-tab');
  if (!tab) return;
  document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
  tab.classList.add('active');
  currentMode = tab.dataset.mode;
  document.getElementById('chatBarMeta').textContent = `MODO: ${currentMode.toUpperCase()} · GUARDS ATIVOS`;
  const statMode = document.getElementById('stat-mode');
  if (statMode) {
    statMode.textContent = currentMode.toUpperCase();
    statMode.style.color = currentMode === 'dev' ? 'var(--cyan)' : currentMode === 'hunter' ? 'var(--amber)' : 'var(--sky)';
  }
  localStorage.setItem('luna_current_mode', currentMode);
});

/* ══════════════════════════════════════════════
   EVENT LISTENERS
══════════════════════════════════════════════ */
msgInput.addEventListener('input', () => {
  msgInput.style.height = 'auto';
  msgInput.style.height = msgInput.scrollHeight + 'px';
  const len = msgInput.value.length;
  charCount.textContent  = len > 0 ? len : '';
  charCount.className    = `char-count${len > 1800 ? ' warn' : ''}`;
});

msgInput.addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.ctrlKey) { e.preventDefault(); sendMessage(); }
});

sendBtn.addEventListener('click', e => {
  const rect   = sendBtn.getBoundingClientRect();
  const ripple = document.createElement('div');
  ripple.className = 'ripple-ring';
  const size = Math.max(sendBtn.offsetWidth, sendBtn.offsetHeight) * 0.5;
  ripple.style.cssText = `width:${size}px;height:${size}px;left:${e.clientX-rect.left-size/2}px;top:${e.clientY-rect.top-size/2}px`;
  sendBtn.appendChild(ripple);
  ripple.addEventListener('animationend', () => ripple.remove());
  sendMessage();
});

newSessionBtn.addEventListener('click', resetChatSession);

