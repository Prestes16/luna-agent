# ════════════════════════════════════════════════════════════════════
#  LUNA AGENT v3.0 — Configuração de Ambiente
#  Copie este arquivo para .env e preencha suas chaves
#  cp .env.example .env
# ════════════════════════════════════════════════════════════════════

# ─── Multi-LLM Router (LunaLLMRouter) ────────────────────────────────────────
# Ordem de prioridade: together → groq → ollama → gemini → openai
# Altere LUNA_LLM_PRIORITY para mudar a ordem (separado por vírgula)
LUNA_LLM_PRIORITY=together,groq,ollama,gemini,openai

# Together AI — Primary (Llama-3.1-405B, contexto 128k)
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Groq — Fallback rápido (Llama-3.1-70B, latência ultra-baixa)
# https://console.groq.com/keys
GROQ_API_KEY=

# Ollama — Fallback local (sem custo, requer Ollama instalado)
# Instale: https://ollama.ai — execute: ollama pull llama3.1
OLLAMA_URL=http://localhost:11434

# Google Gemini — Fallback (contexto 2M tokens)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — Fallback final (GPT-4o)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Grok (xAI) — alternativa ao OpenAI
# https://console.x.ai/
GROK_API_KEY=

# ─── Modelos específicos por provider (opcional) ──────────────────────────────
# Se não definido, usa o modelo padrão de cada provider
# LUNA_TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-405B-Instruct-Turbo
# LUNA_GROQ_MODEL=llama-3.1-70b-versatile
# LUNA_OLLAMA_MODEL=llama3.1:8b
# LUNA_GEMINI_MODEL=gemini-1.5-pro
# LUNA_OPENAI_MODEL=gpt-4o

# ─── Runtime Legado ──────────────────────────────────────────────────────────
# Usado como fallback se LunaLLMRouter não estiver disponível
LUNA_PRIMARY_PROVIDER=openai
LUNA_PRIMARY_MODEL=gpt-4o
LUNA_MODEL=gpt-4o

# ─── Backend API ─────────────────────────────────────────────────────────────
LUNA_PORT=8000
LUNA_API_PORT=8000
LUNA_API_HOST=localhost

# ─── Filesystem / Acesso ─────────────────────────────────────────────────────
# Diretórios que a Luna pode acessar (separados por vírgula, formato WSL)
LUNA_ALLOWED_DIRS=/mnt/d/Dev,/mnt/d/Projects
LUNA_DEV_DIRS=/mnt/d/Dev

# ─── Configuração Geral ───────────────────────────────────────────────────────
LUNA_SAFE_MODE=true
LUNA_ENVIRONMENT=development
LUNA_LOG_LEVEL=WARNING

# ─── APIs Legadas (mantidas para compatibilidade) ─────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# ─── Serviços Opcionais ───────────────────────────────────────────────────────
LUNA_WORKER_TOKEN=meu-token-seguro-aqui
REDIS_URL=redis://localhost:6379/0

# ════════════════════════════════════════════════════════════════════
#  LUNA PAY-FLOW — Sistema de Créditos Automático (Grains / USDC)
#  Preencha esta seção para ativar o sistema de cobrança e lucro.
#  Se SUPABASE_URL estiver vazio, o pay-flow é desativado e Luna
#  opera sem cobrar (modo gratuito).
# ════════════════════════════════════════════════════════════════════

# ─── Supabase — Banco de dados do pay-flow ───────────────────────────────────
# Crie um projeto gratuito em https://supabase.com
# Project Settings → API → Project URL
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Project Settings → API → service_role key (NÃO use a anon key)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Helius — Webhook de pagamentos Solana ───────────────────────────────────
# Crie conta em https://helius.dev e configure um webhook apontando para:
#   https://SEU_DOMINIO/payment/webhook
# O secret gerado pela Helius vai aqui (valida autenticidade do webhook)
HELIUS_WEBHOOK_SECRET=seu_secret_do_webhook_helius

# ─── Admin Dashboard ─────────────────────────────────────────────────────────
# Chave para acessar os endpoints /payment/admin-stats e /reconciliation
# Use uma string longa e aleatória (ex: openssl rand -hex 32)
ADMIN_API_KEY=sua_chave_admin_secreta_aqui

# ─── Carteira Receptora USDC (Solana) ────────────────────────────────────────
# Endereço da carteira que receberá os pagamentos USDC via Solana Pay
# Esta é a carteira que aparece no QR Code enviado ao usuário
LUNA_RECEIVER_WALLET=SuaCarteiraPublicaSolana

# ─── Solana RPC ───────────────────────────────────────────────────────────────
# URL do RPC Solana para verificação on-chain de saldo (reconciliação)
# Use o endpoint Helius com api-key para melhor performance:
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=SUA_HELIUS_API_KEY

# ─── USDC Mint (não mude salvo em teste) ────────────────────────────────────
# Mainnet: EPjFW36vnC7H1Vcr7j94v76q8fP67ZDTdhGV74xl
# Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT=EPjFW36vnC7H1Vcr7j94v76q8fP67ZDTdhGV74xl

# ─── Como ativar o pay-flow passo a passo ────────────────────────────────────
# 1. Crie projeto no Supabase e rode as migrations em ordem:
#      app/payments/migrations/001_payflow_schema.sql
#      app/payments/migrations/002_profit_engine.sql
#      app/payments/migrations/003_reconciliation_log.sql
# 2. Configure SUPABASE_URL + SUPABASE_SERVICE_KEY acima
# 3. Configure sua carteira Solana em LUNA_RECEIVER_WALLET
# 4. No Helius, crie webhook apontando para /payment/webhook
#    e coloque o secret em HELIUS_WEBHOOK_SECRET
# 5. Defina ADMIN_API_KEY (será necessária para acessar /admin-stats)
# 6. Reinicie o backend — o sistema entra em modo de cobrança automática
#
# Markup de lucro configurado em app/payments/grains_manager.py:
#   MODEL_BASIC    → 2.0x  (chat padrão)
#   MODEL_EXPERT   → 2.5x  (análises profundas)
#   MODEL_SECURITY → 3.0x  (ferramentas de security/bounty)
#
# Floor mínimo por operação (app/payments/grains_manager.py OPERATION_FLOOR):
#   luna_chat_message   → 0.10 Grains mínimo por mensagem
#   hunter_scan_1k      → 15.00 Grains por scan de 1k linhas
#   image_video_analysis → 50.00 Grains por análise de imagem/vídeo

# ==== Luna security layer ==========================================
# LUNA_API_TOKEN:         if empty, a random token is auto-generated at
#                         ~/.luna-agent/.api_token and printed on startup.
#                         When launched from Electron, the desktop app
#                         generates its own and injects it into the child
#                         process env automatically.
# LUNA_AUTH_DISABLED=1    disables bearer-token auth (local dev only)
# LUNA_RATE_LIMIT_PER_MIN per-IP rate limit (0 = disabled, default 240)
# LUNA_MAX_BODY_MB        max request body size in MB (default 20)
# LUNA_ALLOWED_ORIGINS    comma-separated CORS origins
# LUNA_ALLOW_NGROK=1      re-enable https://*.ngrok(-free).app regex
LUNA_API_TOKEN=
LUNA_AUTH_DISABLED=
LUNA_RATE_LIMIT_PER_MIN=240
LUNA_MAX_BODY_MB=20
LUNA_ALLOWED_ORIGINS=
LUNA_ALLOW_NGROK=
