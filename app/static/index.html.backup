              </div>
              <!-- Variation prompt (Stability only) -->
              <div class="img-prompt-wrap stability-only" id="varPromptWrap" style="margin-top:10px">
                <textarea class="img-prompt" id="varPrompt" rows="1"
                  placeholder="Prompt de variação (Stability) — opcional, guia a variação..."></textarea>
              </div>
              <div class="img-controls" style="margin-top:12px">
                <div class="img-ctrl">
                  <label>Nº de variações</label>
