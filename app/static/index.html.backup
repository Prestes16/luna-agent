<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Luna Agent</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;600;700;800;900&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    /* ══════════════════════════════
       DESIGN TOKENS
    ══════════════════════════════ */
    :root {
      --bg-0:      #010b1a;
      --bg-1:      #020e22;
      --panel:     rgba(4,12,26,0.92);
      --panel-2:   rgba(3,9,20,0.97);
      --glass:     rgba(6,18,36,0.72);

      --line:      rgba(52,188,255,0.11);
      --line-md:   rgba(52,188,255,0.24);
      --line-hi:   rgba(52,188,255,0.52);

      --text:      #dff0ff;
      --muted:     #6b95bf;
      --dim:       #2e4d6a;
      --faint:     rgba(52,188,255,0.055);

      --cyan:      #34bcff;
      --cyan-2:    #58d4ff;
      --blue:      #1475e8;
      --sky:       #82ccff;
      --ice:       #c2e8ff;
      --amber:     #f09f2e;

      --display:  'Exo 2', sans-serif;
      --body:     'DM Sans', sans-serif;
      --mono:     'JetBrains Mono', monospace;

      --rc:  22px;
      --rb:  16px;
      --rp:  999px;

      --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --eout:   cubic-bezier(0.22, 1, 0.36, 1);
      --ease:   cubic-bezier(0.4, 0, 0.2, 1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      min-height: 100vh;
      font-family: var(--body);
      color: var(--text);
      background: var(--bg-0);
      overflow-x: hidden;
    }

    /* ══════════════════════════════
       BACKGROUND SYSTEM
    ══════════════════════════════ */
    #bg-canvas { position:fixed; inset:0; z-index:0; pointer-events:none; }

    #cursor-aura {
      position: fixed;
      width: 420px; height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(52,188,255,0.065), transparent 65%);
      transform: translate(-50%,-50%);
      pointer-events: none;
      z-index: 0;
      transition: opacity .4s;
      will-change: transform;
    }

    .grid-layer {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(52,188,255,.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(52,188,255,.018) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 40%, black 15%, transparent 100%);
    }

    .ambient { position:fixed; border-radius:50%; filter:blur(110px); pointer-events:none; z-index:0; }
    .a1 { width:720px; height:720px; top:-220px; left:-220px; background:radial-gradient(circle,rgba(20,117,232,.10),transparent 70%); }
    .a2 { width:620px; height:620px; top:-110px; right:-190px; background:radial-gradient(circle,rgba(52,188,255,.08),transparent 70%); }
    .a3 { width:820px; height:520px; bottom:-160px; left:50%; transform:translateX(-50%); background:radial-gradient(circle,rgba(20,117,232,.07),transparent 70%); }

    @keyframes scan { from{transform:translateY(-100%)} to{transform:translateY(110vh)} }
    .scanline {
      position:fixed; left:0; right:0; height:1px; z-index:1; pointer-events:none;
      background:linear-gradient(90deg,transparent,rgba(52,188,255,.08),rgba(52,188,255,.22),rgba(52,188,255,.08),transparent);
      animation: scan 9s linear infinite;
    }

    /* ══════════════════════════════
       NOISE TEXTURE OVERLAY
    ══════════════════════════════ */
    .noise {
      position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: .025;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 200px;
    }

    /* ══════════════════════════════
       LAYOUT ROOT
    ══════════════════════════════ */
    .root { position:relative; z-index:2; min-height:100vh; }
    .shell { width:min(1020px,100%); margin:0 auto; padding:34px 20px 52px; }

    /* ══════════════════════════════
       TOPBAR
    ══════════════════════════════ */
    .topbar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }

    .brand { display:flex; align-items:center; gap:18px; }

    /* Logo ring */
    .logo-ring { position:relative; width:66px; height:66px; flex-shrink:0; }
    .logo-ring svg.ring-svg { position:absolute; inset:0; animation:ring-spin 14s linear infinite; }
    @keyframes ring-spin { to { transform:rotate(360deg); } }
    .logo-ring svg.ring-svg-2 { position:absolute; inset:0; animation:ring-spin 22s linear infinite reverse; opacity:.4; }

    .logo-inner {
      position: absolute; inset: 11px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(20,117,232,.32), rgba(52,188,255,.14));
      display: grid; place-items: center;
      font-size: 23px;
      color: var(--cyan-2);
      filter: drop-shadow(0 0 10px rgba(52,188,255,.6));
    }

    .brand-copy { display:flex; flex-direction:column; gap:5px; }

    .brand-copy h1 {
      font-family: var(--display);
      font-size: clamp(28px, 4.2vw, 46px);
      font-weight: 900;
      letter-spacing: -.055em;
      line-height: 1;
      background: linear-gradient(118deg, #ffffff 18%, var(--sky) 52%, var(--cyan) 80%, var(--cyan-2) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .tagline {
      font-family: var(--mono);
      font-size: 11.5px;
      font-weight: 300;
      color: var(--muted);
      letter-spacing: .03em;
    }
    .tagline em { font-style:normal; color:var(--cyan); }

    /* Top right */
    .top-right { display:flex; flex-direction:column; align-items:flex-end; gap:8px; }

    @keyframes pdot { 0%,100%{box-shadow:0 0 0 0 rgba(52,188,255,.8)} 50%{box-shadow:0 0 0 5px rgba(52,188,255,0)} }
    .dot { width:8px; height:8px; border-radius:50%; background:var(--cyan); animation:pdot 2.4s ease-in-out infinite; flex-shrink:0; }

    .status-pill {
      display: inline-flex; align-items: center; gap: 9px;
      padding: 8px 16px;
      border-radius: var(--rp);
      border: 1px solid var(--line-md);
      background: rgba(4,12,26,.84);
      font-family: var(--mono);
      font-size: 11.5px;
      color: var(--cyan);
      letter-spacing: .055em;
      backdrop-filter: blur(14px);
      cursor: default;
      transition: border-color .2s, box-shadow .2s;
    }
    .status-pill:hover { border-color:var(--line-hi); box-shadow:0 0 20px rgba(52,188,255,.13); }

    .cog-btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 7px 13px;
      border-radius: var(--rp);
      border: 1px solid var(--line);
      background: transparent;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      cursor: pointer;
      letter-spacing: .07em;
      transition: color .2s, border-color .2s, background .2s;
    }
    .cog-btn:hover { color:var(--cyan); border-color:var(--line-md); background:var(--faint); }
    .cog-btn svg { transition:transform .55s var(--eout); }
    .cog-btn:hover svg { transform:rotate(90deg); }

    /* ══════════════════════════════
       MAIN CARD
    ══════════════════════════════ */
    .card {
      border-radius: var(--rc);
      border: 1px solid var(--line);
      background: var(--panel);
      backdrop-filter: blur(30px);
      box-shadow:
        0 36px 110px rgba(0,0,0,.58),
        inset 0 1px 0 rgba(255,255,255,.022),
        inset 0 0 90px rgba(52,188,255,.025);
      overflow: hidden;
      position: relative;
    }

    /* Four corner brackets */
    .card-brackets { position:absolute; inset:0; pointer-events:none; z-index:4; border-radius:var(--rc); }
    .cb { position:absolute; width:24px; height:24px; }
    .cb-tl { top:-1px; left:-1px; border-top:2px solid var(--cyan); border-left:2px solid var(--cyan); border-radius:var(--rc) 0 0 0; }
    .cb-tr { top:-1px; right:-1px; border-top:2px solid var(--cyan); border-right:2px solid var(--cyan); border-radius:0 var(--rc) 0 0; }
    .cb-bl { bottom:-1px; left:-1px; border-bottom:2px solid var(--cyan); border-left:2px solid var(--cyan); border-radius:0 0 0 var(--rc); }
    .cb-br { bottom:-1px; right:-1px; border-bottom:2px solid var(--cyan); border-right:2px solid var(--cyan); border-radius:0 0 var(--rc) 0; }

    /* Top beam */
    .card-beam {
      height: 1px;
      background: linear-gradient(90deg, transparent 3%, var(--line-md) 22%, var(--line-hi) 50%, var(--line-md) 78%, transparent 97%);
    }

    /* Hover shimmer */
    .card-shimmer {
      position: absolute; top:0; left:-100%; width:55%; height:100%;
      background: linear-gradient(108deg, transparent 28%, rgba(52,188,255,.028) 50%, transparent 72%);
      pointer-events: none; z-index:1;
      transition: left .75s var(--eout), opacity .35s;
      opacity: 0;
    }
    .card:hover .card-shimmer { left:130%; opacity:1; }

    /* ══════════════════════════════
       INFO BAND
    ══════════════════════════════ */
    .info-band {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      border-bottom: 1px solid var(--line);
    }
    .info-cell { padding:20px 24px; transition:background .2s; cursor:default; position:relative; }
    .info-cell:hover { background:rgba(52,188,255,.028); }
    .info-cell + .info-cell { border-left:1px solid var(--line); }

    /* live pulse on status cell */
    .info-cell.live::after {
      content: '';
      position: absolute;
      top: 50%; right: 18px;
      transform: translateY(-50%);
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 8px var(--cyan);
      animation: pdot 2.4s ease-in-out infinite;
    }

    .ic-label { font-family:var(--mono); font-size:9.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--dim); margin-bottom:5px; }
    .ic-value { font-family:var(--display); font-size:15px; font-weight:700; color:var(--text); }
    .ic-value.hi { color:var(--cyan); }
    .ic-value.sm { font-family:var(--body); font-size:13px; font-weight:400; color:var(--muted); }

    /* ══════════════════════════════
       SECTION HEADER
    ══════════════════════════════ */
    .sec-head { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
    .sec-label { font-family:var(--mono); font-size:10px; letter-spacing:.15em; color:var(--cyan); text-transform:uppercase; white-space:nowrap; }
    .sec-rule  { flex:1; height:1px; background:linear-gradient(90deg, var(--line-md), transparent); }

    /* ══════════════════════════════
       ABOUT GRID
    ══════════════════════════════ */
    .about-wrap { padding:26px 26px 0; }
    .about-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:26px; }

    .pbox {
      border: 1px solid var(--line);
      border-radius: var(--rb);
      background: var(--panel-2);
      padding: 20px 22px;
      position: relative;
      overflow: hidden;
      transition: border-color .25s, box-shadow .25s, transform .28s var(--spring);
    }
    .pbox::before {
      content: '';
      position: absolute; top:0; left:0; right:0; height:1px;
      background: linear-gradient(90deg, transparent, var(--line-md), transparent);
    }
    .pbox:hover { border-color:var(--line-md); box-shadow:0 0 30px rgba(52,188,255,.07); transform:translateY(-2px); }

    .pbox h3 { font-family:var(--display); font-size:15px; font-weight:700; letter-spacing:-.02em; color:var(--text); margin-bottom:7px; }
    .pbox p  { font-size:13.5px; color:var(--muted); line-height:1.65; }

    .tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:13px; }
    .tag {
      padding: 5px 11px;
      border-radius: var(--rp);
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: .055em;
      color: var(--sky);
      border: 1px solid rgba(52,188,255,.20);
      background: rgba(20,117,232,.07);
      cursor: default;
      user-select: none;
      transition: background .2s, border-color .2s, color .2s, transform .18s var(--spring);
    }
    .tag:hover { background:rgba(52,188,255,.14); border-color:rgba(52,188,255,.46); color:var(--ice); transform:scale(1.07); }

    .stat-row { display:flex; gap:22px; margin-top:16px; }
    .stat-item { display:flex; flex-direction:column; gap:2px; }
    .stat-n {
      font-family: var(--display);
      font-size: 32px;
      font-weight: 900;
      letter-spacing: -.055em;
      line-height: 1;
      background: linear-gradient(135deg, #fff, var(--sky));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .stat-l { font-family:var(--mono); font-size:9.5px; letter-spacing:.10em; color:var(--dim); text-transform:uppercase; }

    /* ══════════════════════════════
       CHAT SHELL
    ══════════════════════════════ */
    .chat-wrap { padding:0 26px 26px; }

    .chat-shell {
      border: 1px solid var(--line);
      border-radius: 19px;
      background: rgba(2,7,17,.82);
      overflow: hidden;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.018), 0 0 0 1px rgba(52,188,255,.04);
    }

    /* Chat header bar */
    .chat-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 18px;
      border-bottom: 1px solid var(--line);
      background: rgba(4,12,26,.62);
    }
    .chat-bar-left { display:flex; align-items:center; gap:10px; }

    .chat-led {
      width:9px; height:9px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 12px var(--cyan);
      animation: pdot 2.4s .5s ease-in-out infinite;
    }

    /* Mode selector tabs */
    .chat-modes { display:flex; gap:4px; }
    .mode-tab {
      padding: 4px 10px;
      border-radius: var(--rp);
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .07em;
      color: var(--dim);
      border: 1px solid transparent;
      background: transparent;
      cursor: pointer;
      transition: color .18s, border-color .18s, background .18s;
      text-transform: uppercase;
    }
    .mode-tab:hover  { color:var(--muted); border-color:var(--line); }
    .mode-tab.active { color:var(--cyan); border-color:var(--line-md); background:rgba(52,188,255,.06); }

    .chat-bar-title { font-family:var(--display); font-size:13.5px; font-weight:700; color:var(--text); letter-spacing:-.01em; }
    .chat-bar-meta  { font-family:var(--mono); font-size:10.5px; color:var(--dim); letter-spacing:.05em; }

    /* Message list */
    .chat-msgs {
      min-height: 100px;
      max-height: 380px;
      overflow-y: auto;
      padding: 18px 18px 10px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      scrollbar-width: thin;
      scrollbar-color: rgba(52,188,255,.16) transparent;
    }
    .chat-msgs::-webkit-scrollbar { width:5px; }
    .chat-msgs::-webkit-scrollbar-thumb { background:rgba(52,188,255,.16); border-radius:99px; }

    /* Empty state */
    .chat-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:32px 0; opacity:.45; }
    .chat-empty-icon { font-size:30px; }
    .chat-empty-txt  { font-family:var(--mono); font-size:11px; color:var(--dim); letter-spacing:.07em; }

    /* Message bubbles */
    @keyframes msg-in { from{opacity:0;transform:translateY(10px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }

    .msg { display:flex; flex-direction:column; max-width:86%; animation:msg-in .3s var(--spring) both; }
    .msg.user  { align-self:flex-end;  align-items:flex-end; }
    .msg.agent { align-self:flex-start; align-items:flex-start; }

    .msg-who {
      font-family: var(--mono);
      font-size: 9.5px;
      letter-spacing: .11em;
      text-transform: uppercase;
      color: var(--dim);
      margin-bottom: 4px;
      padding: 0 4px;
    }

    .msg-bubble { padding:11px 15px; font-size:14px; line-height:1.68; }

    .msg.user  .msg-bubble {
      border-radius: 16px 16px 4px 16px;
      background: linear-gradient(138deg, rgba(20,117,232,.30), rgba(52,188,255,.13));
      border: 1px solid rgba(52,188,255,.27);
      color: var(--text);
      font-family: var(--body);
    }
    .msg.agent .msg-bubble {
      border-radius: 16px 16px 16px 4px;
      background: var(--panel-2);
      border: 1px solid var(--line);
      color: var(--text);
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 300;
    }

    /* Safe-mode badge on agent bubble */
    .msg.agent.safe .msg-bubble {
      border-color: rgba(240,159,46,.22);
      box-shadow: inset 0 0 18px rgba(240,159,46,.04);
    }
    .msg.agent.safe .msg-who::after {
      content: ' · 🔒';
      color: var(--amber);
      font-size: 9px;
    }

    /* Error message (backend/system error — not Luna's response) */
    .msg.agent.error .msg-bubble {
      border-color: rgba(240,159,46,.30);
      background: rgba(240,159,46,.05);
      color: var(--amber);
      font-size: 12px;
    }
    .msg.agent.error .msg-who::after {
      content: ' · sistema';
      color: rgba(240,159,46,.6);
    }

    /* Typewriter cursor */
    @keyframes blink-cur { 0%,100%{opacity:1} 50%{opacity:0} }
    .typing-text::after { content:'▋'; color:var(--cyan); animation:blink-cur .85s step-end infinite; }

    /* Typing indicator */
    .typing-row {
      display: flex; align-items: center; gap:5px;
      padding: 12px 16px;
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 16px 16px 16px 4px;
      width: fit-content;
    }
    .tdot { width:6px; height:6px; border-radius:50%; background:var(--cyan); opacity:.28; }
    @keyframes td { 0%,100%{opacity:.2;transform:scale(.82)} 50%{opacity:1;transform:scale(1.18)} }
    .tdot:nth-child(1) { animation:td 1.35s 0s    infinite; }
    .tdot:nth-child(2) { animation:td 1.35s .24s  infinite; }
    .tdot:nth-child(3) { animation:td 1.35s .48s  infinite; }

    /* ══════════════════════════════
       INPUT AREA
    ══════════════════════════════ */
    .input-area {
      padding: 14px 16px;
      border-top: 1px solid var(--line);
      background: rgba(2,7,17,.52);
    }
    .input-row { display:flex; align-items:flex-end; gap:11px; }
    .ta-wrap   { flex:1; position:relative; }

    textarea {
      width: 100%;
      min-height: 50px; max-height: 150px;
      resize: none;
      border-radius: 13px;
      border: 1px solid var(--line-md);
      background: rgba(5,13,28,.92);
      color: var(--text);
      padding: 13px 46px 13px 16px;
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 300;
      line-height: 1.55;
      outline: none;
      transition: border-color .25s, box-shadow .25s;
    }
    textarea::placeholder { color:var(--dim); }
    textarea:focus {
      border-color: rgba(52,188,255,.44);
      box-shadow: 0 0 0 3px rgba(52,188,255,.09), 0 0 22px rgba(52,188,255,.06);
    }

    .char-count {
      position: absolute; bottom:8px; right:10px;
      font-family: var(--mono); font-size:10px;
      color: var(--dim); pointer-events:none;
      transition: color .2s;
    }
    .char-count.warn { color: var(--amber); }

    /* Send button */
    .send-btn {
      flex-shrink: 0;
      width:50px; height:50px;
      border-radius: 13px;
      border: 1px solid rgba(52,188,255,.28);
      background: linear-gradient(138deg, rgba(20,117,232,.25), rgba(52,188,255,.12));
      color: var(--cyan);
      cursor: pointer;
      display: grid; place-items: center;
      position: relative; overflow: hidden;
      transition: transform .22s var(--spring), box-shadow .22s, border-color .22s, background .22s;
      box-shadow: 0 0 16px rgba(52,188,255,.08);
    }
    .send-btn:hover:not(:disabled) {
      transform: translateY(-2px) scale(1.05);
      border-color: rgba(52,188,255,.58);
      background: linear-gradient(138deg, rgba(20,117,232,.40), rgba(52,188,255,.22));
      box-shadow: 0 7px 26px rgba(52,188,255,.24), 0 0 32px rgba(52,188,255,.14);
    }
    .send-btn:active:not(:disabled) { transform:scale(.91); }
    .send-btn:disabled { opacity:.35; cursor:not-allowed; transform:none; }

    /* Ripple */
    .ripple-ring {
      position:absolute; border-radius:50%;
      background: rgba(52,188,255,.32);
      transform:scale(0);
      animation: ripple .6s var(--eout) forwards;
      pointer-events:none;
    }
    @keyframes ripple { to { transform:scale(4.5); opacity:0; } }

    /* Spinner inside button */
    .send-spinner { position:absolute; inset:0; border-radius:13px; display:none; place-items:center; background:rgba(2,8,18,.78); }
    .send-spinner.show { display:grid; }
    @keyframes spin360 { to{transform:rotate(360deg)} }
    .send-spinner svg { animation:spin360 .75s linear infinite; }

    /* Input meta row */
    .input-meta { display:flex; align-items:center; justify-content:space-between; margin-top:8px; padding:0 2px; }
    .input-hint  { font-family:var(--mono); font-size:10.5px; color:var(--dim); letter-spacing:.04em; }
    .input-hint em { font-style:normal; color:var(--muted); }

    /* ══════════════════════════════
       FOOTER BAR
    ══════════════════════════════ */
    .footer-bar {
      display: flex; align-items:center; justify-content:space-between;
      flex-wrap:wrap; gap:12px;
      padding:14px 26px;
      border-top:1px solid var(--line);
    }
    .footer-pills { display:flex; gap:7px; }
    .fpill {
      font-family: var(--mono); font-size:10.5px;
      color: var(--dim);
      padding: 5px 11px;
      border: 1px solid var(--line);
      border-radius: var(--rp);
      letter-spacing: .055em;
      cursor:pointer;
      transition: color .2s, border-color .2s, background .2s;
      user-select:none;
    }
    .fpill.active, .fpill:hover { color:var(--cyan); border-color:rgba(52,188,255,.32); background:rgba(52,188,255,.06); }

    .footer-stack { font-family:var(--mono); font-size:10.5px; color:var(--dim); letter-spacing:.04em; }
    .footer-stack span { color:var(--muted); }

    /* Phase badge */
    .phase-badge {
      font-family: var(--mono); font-size:10px; letter-spacing:.08em;
      color: #4ade80;
      padding: 3px 9px;
      border: 1px solid rgba(74,222,128,.22);
      border-radius: var(--rp);
      background: rgba(74,222,128,.05);
    }

    /* ══════════════════════════════
       SETTINGS DRAWER
    ══════════════════════════════ */
    .drawer-overlay {
      position:fixed; inset:0; z-index:100;
      background:rgba(1,8,20,.68);
      backdrop-filter:blur(7px);
      opacity:0; pointer-events:none;
      transition:opacity .3s;
    }
    .drawer-overlay.open { opacity:1; pointer-events:all; }

    .drawer {
      position:fixed; top:0; right:0; bottom:0;
      width:min(430px,100vw);
      z-index:101;
      background:linear-gradient(172deg,#030d1e,#050f22);
      border-left:1px solid var(--line-md);
      box-shadow:-28px 0 90px rgba(0,0,0,.58);
      transform:translateX(100%);
      transition:transform .4s var(--eout);
      overflow-y:auto;
      scrollbar-width:thin;
      scrollbar-color:var(--line) transparent;
    }
    .drawer.open { transform:translateX(0); }

    .drawer-head {
      display:flex; align-items:center; justify-content:space-between;
      padding:22px 24px 18px;
      border-bottom:1px solid var(--line);
      position:sticky; top:0;
      background:linear-gradient(172deg,#030d1e,#050f22);
      z-index:1;
    }
    .drawer-head h2 { font-family:var(--display); font-size:18px; font-weight:800; letter-spacing:-.03em; color:var(--text); }

    .close-btn {
      width:34px; height:34px; border-radius:50%;
      border:1px solid var(--line); background:transparent;
      color:var(--muted); cursor:pointer;
      display:grid; place-items:center;
      font-size:18px; line-height:1;
      transition:color .2s, border-color .2s, background .2s, transform .22s;
    }
    .close-btn:hover { color:var(--cyan); border-color:var(--line-md); background:var(--faint); transform:rotate(90deg); }

    .drawer-body { padding:22px 24px 40px; display:flex; flex-direction:column; gap:20px; }

    .dfield { display:flex; flex-direction:column; gap:6px; }
    .dfield label { font-family:var(--mono); font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }

    .dfield input,
    .dfield textarea,
    .dfield select {
      width:100%;
      border-radius:10px;
      border:1px solid var(--line-md);
      background:rgba(3,9,20,.90);
      color:var(--text);
      padding:10px 14px;
      font-family:var(--mono); font-size:12.5px;
      outline:none;
      transition:border-color .2s, box-shadow .2s;
      resize:none;
    }
    .dfield input:focus,
    .dfield textarea:focus,
    .dfield select:focus { border-color:rgba(52,188,255,.46); box-shadow:0 0 0 3px rgba(52,188,255,.09); }

    .dfield select { cursor:pointer; }
    .dfield select option { background:#030d1e; }

    .dsep  { height:1px; background:var(--line); }
    .dsec  { font-family:var(--mono); font-size:9.5px; letter-spacing:.15em; color:var(--cyan); text-transform:uppercase; }

    .save-btn {
      appearance:none; border:0;
      width:100%;
      padding:13px 18px;
      border-radius:12px;
      background:linear-gradient(138deg, var(--blue), var(--cyan));
      color:#010b17;
      font-family:var(--display); font-size:14px; font-weight:800; letter-spacing:.02em;
      cursor:pointer;
      transition:transform .18s var(--spring), box-shadow .18s;
      box-shadow:0 9px 30px rgba(52,188,255,.24);
    }
    .save-btn:hover  { transform:translateY(-1px); box-shadow:0 13px 38px rgba(52,188,255,.32); }
    .save-btn:active { transform:scale(.97); }

    /* ══════════════════════════════
       TOAST
    ══════════════════════════════ */
    #toast {
      position:fixed; bottom:28px; right:28px; z-index:200;
      padding:12px 20px;
      border-radius:12px;
      border:1px solid var(--line-md);
      background:rgba(4,14,30,.97);
      font-family:var(--mono); font-size:12px; color:var(--cyan);
      letter-spacing:.04em;
      backdrop-filter:blur(14px);
      transform:translateY(22px); opacity:0;
      transition:transform .32s var(--spring), opacity .32s;
      pointer-events:none;
    }
    #toast.show { transform:translateY(0); opacity:1; }

    /* ══════════════════════════════
       ENTRY ANIMATIONS
    ══════════════════════════════ */
    @keyframes fade-up { from{opacity:0;transform:translateY(22px)} to{opacity:1;transform:translateY(0)} }
    .topbar { animation:fade-up .52s .05s var(--eout) both; }
    .card   { animation:fade-up .62s .16s var(--eout) both; }

    /* ══════════════════════════════
       RESPONSIVE
    ══════════════════════════════ */
    /* ══════════════════════════════
       PANEL TABS NAVIGATION
    ══════════════════════════════ */
    .panel-nav {
      display: flex;
      align-items: center;
      gap: 2px;
      padding: 12px 20px 0;
      border-bottom: 1px solid var(--line);
      background: rgba(2,7,17,.45);
    }

    .panel-tab {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 18px 11px;
      font-family: var(--mono); font-size: 11px; letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--dim);
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      cursor: pointer;
      margin-bottom: -1px;
      transition: color .2s, border-color .2s;
      white-space: nowrap;
    }
    .panel-tab:hover  { color: var(--muted); }
    .panel-tab.active { color: var(--cyan); border-bottom-color: var(--cyan); }
    .panel-tab .tab-icon { font-size: 13px; }
    .panel-tab .tab-badge {
      font-size: 9px; padding: 1px 6px; border-radius: 99px;
      background: rgba(52,188,255,.14); color: var(--cyan);
      border: 1px solid rgba(52,188,255,.22);
    }

    .panel-content { display: none; }
    .panel-content.active { display: block; }

    /* ══════════════════════════════
       IMAGE PANEL
    ══════════════════════════════ */
    .img-panel-wrap { padding: 22px 26px 28px; }

    /* Image mode selector */
    .img-modes {
      display: flex; gap: 6px; margin-bottom: 20px;
      border-bottom: 1px solid var(--line); padding-bottom: 14px;
    }
    .img-mode-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 7px 14px;
      border-radius: var(--rp);
      font-family: var(--mono); font-size: 10.5px; letter-spacing: .07em;
      color: var(--dim); border: 1px solid var(--line);
      background: transparent; cursor: pointer;
      transition: all .18s;
      text-transform: uppercase;
    }
    .img-mode-btn:hover  { color: var(--muted); border-color: var(--line-md); }
    .img-mode-btn.active { color: var(--cyan); border-color: var(--line-md); background: rgba(52,188,255,.06); }

    /* Image sub-panels */
    .img-sub { display: none; }
    .img-sub.active { display: block; }

    /* Generate form */
    .img-form { display: flex; flex-direction: column; gap: 14px; }

    .img-prompt-wrap { position: relative; }
    .img-prompt {
      width: 100%; min-height: 72px; max-height: 180px; resize: none;
      border-radius: 13px; border: 1px solid var(--line-md);
      background: rgba(5,13,28,.92); color: var(--text);
      padding: 13px 16px; font-family: var(--mono);
      font-size: 13px; font-weight: 300; line-height: 1.55;
      outline: none; transition: border-color .25s, box-shadow .25s;
    }
    .img-prompt::placeholder { color: var(--dim); }
    .img-prompt:focus {
      border-color: rgba(52,188,255,.44);
      box-shadow: 0 0 0 3px rgba(52,188,255,.09), 0 0 22px rgba(52,188,255,.06);
    }

    .img-controls {
      display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end;
    }
    .img-ctrl { display: flex; flex-direction: column; gap: 5px; min-width: 120px; }
    .img-ctrl label {
      font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em;
      text-transform: uppercase; color: var(--muted);
    }
    .img-ctrl select {
      border-radius: 9px; border: 1px solid var(--line-md);
      background: rgba(3,9,20,.90); color: var(--text);
      padding: 8px 12px; font-family: var(--mono); font-size: 12px;
      outline: none; cursor: pointer;
      transition: border-color .2s, box-shadow .2s;
    }
    .img-ctrl select:focus {
      border-color: rgba(52,188,255,.46);
      box-shadow: 0 0 0 3px rgba(52,188,255,.09);
    }
    .img-ctrl select option { background: #030d1e; }

    .img-generate-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 11px 24px; border-radius: 12px;
      background: linear-gradient(138deg, var(--blue), var(--cyan));
      color: #010b17; border: none; cursor: pointer;
      font-family: var(--display); font-size: 13px; font-weight: 800;
      letter-spacing: .02em; white-space: nowrap;
      transition: transform .18s var(--spring), box-shadow .18s, opacity .2s;
      box-shadow: 0 7px 24px rgba(52,188,255,.22);
      align-self: flex-end;
    }
    .img-generate-btn:hover:not(:disabled)  { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(52,188,255,.34); }
    .img-generate-btn:active:not(:disabled) { transform: scale(.96); }
    .img-generate-btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }

    /* Upload zone */
    .upload-zone {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 8px;
      border: 1.5px dashed var(--line-md);
      border-radius: 14px;
      background: rgba(5,13,28,.55);
      padding: 28px 20px;
      cursor: pointer; text-align: center;
      transition: border-color .2s, background .2s;
      position: relative;
    }
    .upload-zone:hover { border-color: rgba(52,188,255,.44); background: rgba(52,188,255,.03); }
    .upload-zone.has-file { border-color: rgba(52,188,255,.38); background: rgba(52,188,255,.04); }
    .upload-zone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .upload-icon { font-size: 26px; opacity: .55; }
    .upload-label { font-family: var(--mono); font-size: 11px; color: var(--muted); letter-spacing: .06em; }
    .upload-hint  { font-family: var(--mono); font-size: 10px; color: var(--dim); }
    .upload-name  { font-family: var(--mono); font-size: 11px; color: var(--cyan); margin-top: 2px; }

    .img-edit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }

    /* Result preview */
    .img-result {
      margin-top: 18px;
      display: none;
    }
    .img-result.visible { display: block; }
    .img-result-inner {
      border-radius: 14px; overflow: hidden;
      border: 1px solid var(--line-md);
      background: var(--panel-2);
      padding: 14px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .img-result-img {
      width: 100%; border-radius: 10px;
      display: block; max-height: 512px; object-fit: contain;
    }
    .img-result-meta {
      font-family: var(--mono); font-size: 10.5px; color: var(--muted);
      line-height: 1.7;
    }
    .img-result-meta strong { color: var(--text); }
    .img-result-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .img-action-btn {
      padding: 6px 14px; border-radius: 8px;
      font-family: var(--mono); font-size: 10px; letter-spacing: .07em;
      cursor: pointer; border: 1px solid var(--line-md);
      background: transparent; color: var(--muted);
      transition: color .18s, border-color .18s, background .18s;
      text-transform: uppercase;
    }
    .img-action-btn:hover { color: var(--cyan); border-color: rgba(52,188,255,.32); background: rgba(52,188,255,.06); }
    .img-action-btn.danger:hover { color: #f87171; border-color: rgba(248,113,113,.3); background: rgba(248,113,113,.05); }

    /* Gallery */
    .gallery-section { margin-top: 28px; }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }

    .gallery-card {
      border-radius: 12px; overflow: hidden;
      border: 1px solid var(--line);
      background: var(--panel-2);
      cursor: pointer;
      transition: border-color .22s, box-shadow .22s, transform .22s var(--spring);
      position: relative;
    }
    .gallery-card:hover {
      border-color: var(--line-md);
      box-shadow: 0 8px 28px rgba(52,188,255,.12);
      transform: translateY(-3px);
    }

    .gallery-img {
      width: 100%; aspect-ratio: 1; object-fit: cover; display: block;
    }
    .gallery-card-meta {
      padding: 8px 10px;
    }
    .gallery-card-prompt {
      font-family: var(--mono); font-size: 10px; color: var(--muted);
      line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .gallery-card-footer {
      display: flex; align-items: center; justify-content: space-between;
      margin-top: 5px; gap: 4px;
    }
    .gallery-type-badge {
      font-family: var(--mono); font-size: 8.5px; letter-spacing: .08em;
      padding: 2px 7px; border-radius: 99px;
      background: rgba(52,188,255,.08); color: var(--cyan);
      border: 1px solid rgba(52,188,255,.18);
      text-transform: uppercase;
    }
    .gallery-del-btn {
      font-size: 11px; cursor: pointer; color: var(--dim);
      background: none; border: none; padding: 2px 4px;
      border-radius: 4px; transition: color .15s, background .15s;
    }
    .gallery-del-btn:hover { color: #f87171; background: rgba(248,113,113,.08); }

    .gallery-empty {
      text-align: center; padding: 36px 0;
      font-family: var(--mono); font-size: 11px; color: var(--dim);
      letter-spacing: .06em;
    }

    /* Spinner inside generate btn */
    @keyframes spin-img { to { transform: rotate(360deg); } }
    .img-spinner {
      display: none; width: 14px; height: 14px;
      border: 2px solid rgba(1,11,26,.4);
      border-top-color: rgba(1,11,26,.9);
      border-radius: 50%;
      animation: spin-img .7s linear infinite;
    }
    .generating .img-spinner { display: block; }
    .generating .img-btn-label { opacity: .6; }

    /* Progress bar */
    .img-progress {
      height: 3px; border-radius: 99px; background: var(--line);
      overflow: hidden; margin-top: 4px; display: none;
    }
    .img-progress.active { display: block; }
    .img-progress-bar {
      height: 100%; width: 0%; border-radius: 99px;
      background: linear-gradient(90deg, var(--blue), var(--cyan));
      transition: width .4s var(--eout);
    }

    /* Agent panel */
    .agent-panel-wrap { padding: 22px 26px 28px; }
    .agent-state-box {
      border: 1px solid var(--line);
      border-radius: 13px;
      background: var(--panel-2);
      padding: 18px 20px;
      margin-bottom: 14px;
    }
    .agent-state-box pre {
      font-family: var(--mono); font-size: 11.5px; color: var(--muted);
      line-height: 1.65; white-space: pre-wrap; word-break: break-word;
    }

    @media(max-width:680px) {
      .shell { padding:16px 12px 38px; }
      .about-grid { grid-template-columns:1fr; }
      .info-band  { grid-template-columns:1fr; }
      .info-cell+.info-cell { border-left:none; border-top:1px solid var(--line); }
      .topbar { flex-direction:column; }
      .top-right { align-items:flex-start; }
      .about-wrap,.chat-wrap { padding-left:14px; padding-right:14px; }
      .footer-bar { flex-direction:column; align-items:flex-start; }
      .chat-modes { display:none; }
      .img-edit-grid { grid-template-columns: 1fr; }
      .img-controls  { flex-direction: column; }
      .gallery-grid  { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
      .img-panel-wrap, .agent-panel-wrap { padding: 16px 14px 20px; }
    }

    /* ══════════════════════════════
       WORKSPACE SELECTOR
    ══════════════════════════════ */
    .ws-cell { position:relative; cursor:pointer; user-select:none; }
    .ws-cell:hover .ic-value { color:var(--cyan-2); }
    .ws-arrow { font-size:9px; opacity:.6; margin-left:5px; transition:transform .2s; }
    .ws-cell.open .ws-arrow { transform:rotate(180deg); }

    .ws-dropdown {
      position: absolute; top:calc(100% + 4px); left:0; z-index:50;
      min-width: 200px;
      background: linear-gradient(172deg,#030d1e,#050f22);
      border: 1px solid var(--line-md);
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,.55);
      padding: 6px;
      display: none;
      flex-direction: column;
      gap: 2px;
    }
    .ws-cell.open .ws-dropdown { display:flex; }

    .ws-option {
      display: flex; align-items: center; justify-content: space-between;
      padding: 9px 12px;
      border-radius: 8px;
      font-family: var(--mono); font-size: 12px;
      color: var(--muted);
      cursor: pointer;
      transition: background .15s, color .15s;
      gap: 8px;
    }
    .ws-option:hover { background: rgba(52,188,255,.07); color: var(--text); }
    .ws-option.active { color: var(--cyan); background: rgba(52,188,255,.06); }
    .ws-option-badge {
      font-size: 9px; letter-spacing: .07em;
      padding: 2px 6px;
      border-radius: 99px;
      border: 1px solid;
    }
    .ws-option-badge.ok  { color:#4ade80; border-color:rgba(74,222,128,.3); }
    .ws-option-badge.warn { color:var(--amber); border-color:rgba(240,159,46,.3); }

    /* ══════════════════════════════
       CONTEXT PANEL
    ══════════════════════════════ */
    .ctx-panel {
      border-top: 1px solid var(--line);
      overflow: hidden;
      max-height: 0;
      transition: max-height .38s var(--eout), opacity .3s;
      opacity: 0;
    }
    .ctx-panel.open { max-height: 400px; opacity: 1; }

    .ctx-inner { padding: 20px 26px 22px; display:flex; flex-direction:column; gap:14px; }
    .ctx-cols  { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    .ctx-box {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px 16px;
    }
    .ctx-box h4 {
      font-family: var(--mono); font-size: 9.5px; letter-spacing: .14em;
      text-transform: uppercase; color: var(--cyan); margin-bottom: 8px;
    }
    .ctx-box pre {
      font-family: var(--mono); font-size: 11.5px; color: var(--muted);
      line-height: 1.65; white-space: pre-wrap; word-break: break-word;
      max-height: 160px; overflow-y: auto;
      scrollbar-width: thin; scrollbar-color: var(--line) transparent;
    }

    .ctx-toggle-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px;
      border-radius: var(--rp);
      font-family: var(--mono); font-size: 10px; letter-spacing: .07em;
      color: var(--dim);
      border: 1px solid transparent;
      background: transparent;
      cursor: pointer;
      transition: color .18s, border-color .18s, background .18s;
      text-transform: uppercase;
    }
    .ctx-toggle-btn:hover  { color:var(--muted); border-color:var(--line); }
    .ctx-toggle-btn.active { color:var(--cyan); border-color:var(--line-md); background:rgba(52,188,255,.06); }

    /* ══════════════════════════════
       APPROVAL PANEL
    ══════════════════════════════ */
    .approval-panel {
      margin: 0 26px 18px;
      border: 1px solid rgba(240,159,46,.25);
      border-radius: 14px;
      background: rgba(240,159,46,.04);
      overflow: hidden;
      display: none;
    }
    .approval-panel.visible { display: block; }

    .approval-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px;
      border-bottom: 1px solid rgba(240,159,46,.15);
      font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em;
      color: var(--amber);
    }

    .approval-list { padding: 10px; display: flex; flex-direction: column; gap: 8px; }

    .approval-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 12px;
      border-radius: 9px;
      background: var(--panel-2);
      border: 1px solid var(--line);
      gap: 10px;
    }
    .approval-item-info {
      font-family: var(--mono); font-size: 11.5px; color: var(--text);
      flex: 1; min-width: 0;
    }
    .approval-item-info span { color: var(--muted); font-size: 10px; display: block; margin-top: 2px; }
    .approval-actions { display: flex; gap: 6px; flex-shrink: 0; }

    .approve-btn, .deny-btn {
      padding: 5px 12px;
      border-radius: 7px;
      font-family: var(--mono); font-size: 10px; letter-spacing: .06em;
      cursor: pointer; border: 1px solid;
      transition: background .18s, transform .15s;
    }
    .approve-btn:hover, .deny-btn:hover { transform: translateY(-1px); }
    .approve-btn { color:#4ade80; border-color:rgba(74,222,128,.3); background:rgba(74,222,128,.06); }
    .approve-btn:hover { background:rgba(74,222,128,.14); }
    .deny-btn { color:var(--amber); border-color:rgba(240,159,46,.3); background:rgba(240,159,46,.06); }
    .deny-btn:hover { background:rgba(240,159,46,.14); }

    @media(max-width:680px) {
      .ctx-cols { grid-template-columns: 1fr; }
      .approval-panel { margin: 0 14px 14px; }
    }

    /* ══════════════════════════════
       AGENT PANEL V2
    ══════════════════════════════ */
    .agent-panel-wrap { padding: 22px 26px 28px; display: flex; flex-direction: column; gap: 20px; }

    /* Plan form */
    .agent-plan-form { display: flex; flex-direction: column; gap: 10px; }
    .agent-plan-row  { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
    .agent-plan-textarea {
      flex: 1; min-width: 220px; min-height: 56px; resize: none;
      border-radius: 11px; border: 1px solid var(--line-md);
      background: rgba(5,13,28,.92); color: var(--text);
      padding: 11px 14px; font-family: var(--mono); font-size: 12.5px;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .agent-plan-textarea:focus { border-color: rgba(52,188,255,.44); box-shadow: 0 0 0 3px rgba(52,188,255,.09); }
    .agent-plan-select {
      flex-shrink: 0; padding: 10px 12px;
      border-radius: 11px; border: 1px solid var(--line-md);
      background: rgba(5,13,28,.92); color: var(--muted);
      font-family: var(--mono); font-size: 12px; cursor: pointer; outline: none;
    }
    .agent-plan-btn {
      flex-shrink: 0; padding: 10px 22px;
      border-radius: 11px; border: 1px solid rgba(52,188,255,.28);
      background: linear-gradient(138deg, rgba(20,117,232,.25), rgba(52,188,255,.12));
      color: var(--cyan); font-family: var(--mono); font-size: 11px; letter-spacing: .07em;
      cursor: pointer; text-transform: uppercase;
      transition: background .2s, transform .18s, border-color .2s;
    }
    .agent-plan-btn:hover { background: linear-gradient(138deg, rgba(20,117,232,.40), rgba(52,188,255,.22)); transform: translateY(-1px); }

    /* Queue */
    .queue-section { display: flex; flex-direction: column; gap: 10px; }
    .queue-empty { font-family: var(--mono); font-size: 11px; color: var(--dim); padding: 14px 0; }

    .queue-item {
      border-radius: 12px; border: 1px solid var(--line);
      background: var(--panel-2); overflow: hidden;
      transition: border-color .2s;
    }
    .queue-item.risk-low    { border-color: rgba(52,188,255,.22); }
    .queue-item.risk-medium { border-color: rgba(240,159,46,.22); }
    .queue-item.risk-high   { border-color: rgba(239,68,68,.30); }
    .queue-item.approved    { border-color: rgba(74,222,128,.30); }

    .queue-item-head {
      display: flex; align-items: center; gap: 10px;
      padding: 11px 14px;
      cursor: pointer;
    }
    .risk-badge {
      font-family: var(--mono); font-size: 9px; letter-spacing: .1em;
      padding: 3px 8px; border-radius: 99px; text-transform: uppercase; flex-shrink: 0;
    }
    .risk-badge.low    { color: var(--cyan); background: rgba(52,188,255,.10); border: 1px solid rgba(52,188,255,.22); }
    .risk-badge.medium { color: var(--amber); background: rgba(240,159,46,.08); border: 1px solid rgba(240,159,46,.22); }
    .risk-badge.high   { color: #ef4444; background: rgba(239,68,68,.08); border: 1px solid rgba(239,68,68,.25); }

    .queue-tool-label { font-family: var(--mono); font-size: 12.5px; color: var(--text); font-weight: 500; }
    .queue-reason     { font-family: var(--mono); font-size: 10.5px; color: var(--muted); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .queue-chevron    { color: var(--dim); font-size: 11px; flex-shrink: 0; transition: transform .2s; }
    .queue-item.expanded .queue-chevron { transform: rotate(90deg); }

    .queue-item-body { display: none; padding: 0 14px 14px; }
    .queue-item.expanded .queue-item-body { display: block; }

    .queue-preview {
      font-family: var(--mono); font-size: 11.5px; color: var(--muted);
      background: rgba(2,7,17,.62); border-radius: 8px;
      padding: 10px 12px; margin-bottom: 10px;
      white-space: pre-wrap; word-break: break-all;
    }

    .queue-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .qa-btn {
      padding: 6px 16px; border-radius: 8px;
      font-family: var(--mono); font-size: 10.5px; letter-spacing: .06em;
      cursor: pointer; border: 1px solid; text-transform: uppercase;
      transition: background .18s, transform .15s;
    }
    .qa-btn:hover { transform: translateY(-1px); }
    .qa-approve { color: #4ade80; border-color: rgba(74,222,128,.3); background: rgba(74,222,128,.06); }
    .qa-approve:hover { background: rgba(74,222,128,.14); }
    .qa-deny    { color: #ef4444; border-color: rgba(239,68,68,.28); background: rgba(239,68,68,.05); }
    .qa-deny:hover { background: rgba(239,68,68,.12); }
    .qa-exec    { color: var(--cyan); border-color: rgba(52,188,255,.28); background: rgba(52,188,255,.07); }
    .qa-exec:hover { background: rgba(52,188,255,.16); }
    .qa-approved-badge { font-family: var(--mono); font-size: 10px; color: #4ade80; padding: 6px 0; }

    /* Result box */
    .agent-result-box {
      border-radius: 11px; border: 1px solid var(--line);
      background: rgba(2,7,17,.62); padding: 14px 16px;
      font-family: var(--mono); font-size: 11.5px; color: var(--muted);
      white-space: pre-wrap; max-height: 200px; overflow-y: auto;
    }
    .agent-result-box.ok  { border-color: rgba(74,222,128,.25); color: #4ade80; }
    .agent-result-box.err { border-color: rgba(239,68,68,.25);  color: #ef4444; }

    /* Audit log */
    .audit-list { display: flex; flex-direction: column; gap: 6px; }
    .audit-item {
      display: grid; grid-template-columns: auto 1fr auto auto;
      align-items: center; gap: 10px;
      padding: 8px 12px;
      border-radius: 8px;
      background: rgba(3,9,20,.7);
      border: 1px solid var(--line);
      font-family: var(--mono); font-size: 10.5px;
    }
    .audit-ts      { color: var(--dim); white-space: nowrap; }
    .audit-desc    { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .audit-result  { font-weight: 600; white-space: nowrap; }
    .audit-result.ok { color: #4ade80; }
    .audit-result.err { color: #ef4444; }
    .audit-result.pend { color: var(--amber); }
    .audit-decision { color: var(--dim); font-size: 9.5px; }

    /* ══════════════════════════════
       EXECUTION TARGET & BRIDGE STATUS
    ══════════════════════════════ */
    .exec-target-group {
      display: flex; align-items: center; gap: 8px;
    }
    .exec-btns {
      display: flex; border: 1px solid var(--line-md); border-radius: var(--rp);
      overflow: hidden;
    }
    .exec-btn {
      padding: 4px 12px; font-size: 10.5px; font-weight: 700; letter-spacing:.06em;
      text-transform: uppercase; cursor: pointer; border: none; outline: none;
      background: transparent; color: var(--muted); font-family: var(--mono);
      transition: background .15s, color .15s;
    }
    .exec-btn.active {
      background: rgba(52,188,255,.18); color: var(--cyan);
    }
    .exec-btn:hover:not(.active) { background: rgba(52,188,255,.07); color: var(--text); }

    .bridge-indicator {
      display: flex; align-items: center; gap: 5px;
      font-family: var(--mono); font-size: 10px; color: var(--muted);
      padding: 3px 8px; border-radius: var(--rp);
      border: 1px solid var(--line);
      background: rgba(0,0,0,.2);
      cursor: default;
    }
    .bridge-dot {
      width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
      background: var(--dim);
      transition: background .3s;
    }
    .bridge-dot.online  { background: #4ade80; box-shadow: 0 0 6px #4ade8088; }
    .bridge-dot.offline { background: #ef4444; }
    .bridge-dot.checking { background: var(--amber); animation: pulse-amber .8s ease infinite alternate; }
    @keyframes pulse-amber { from {opacity:.5} to {opacity:1} }

    /* ══════════════════════════════
       SCREEN OBSERVATION PANEL
    ══════════════════════════════ */
    .screen-observe {
      display: flex; flex-direction: column; gap: 14px;
      padding: 18px 20px;
      background: rgba(3,9,20,.6);
      border: 1px solid var(--line);
      border-radius: var(--rc);
    }
    .screen-observe-header {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .screen-observe-title {
      font-family: var(--mono); font-size: 11.5px; color: var(--cyan);
      letter-spacing: .1em; text-transform: uppercase;
    }
    .screen-observe-actions { display: flex; gap: 8px; align-items: center; }

    .screen-preview-wrap {
      position: relative; border-radius: 10px; overflow: hidden;
      border: 1px solid var(--line); background: rgba(0,0,0,.5);
      min-height: 80px; display: flex; align-items: center; justify-content: center;
    }
    .screen-preview-wrap.has-img { min-height: unset; }
    .screen-preview-img {
      width: 100%; display: block; border-radius: 10px;
    }
    .screen-preview-empty {
      padding: 24px; color: var(--dim); font-size: 11.5px; font-family: var(--mono);
      text-align: center;
    }
    .screen-preview-overlay {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: linear-gradient(transparent, rgba(1,11,26,.85));
      padding: 8px 12px; font-family: var(--mono); font-size: 10px; color: var(--muted);
      display: flex; justify-content: space-between; align-items: flex-end;
    }

    .screen-meta {
      display: flex; gap: 14px; flex-wrap: wrap;
      font-family: var(--mono); font-size: 10.5px; color: var(--muted);
    }
    .screen-meta span { color: var(--text); }

    .screen-analysis-box {
      background: rgba(52,188,255,.04);
      border: 1px solid var(--line);
      border-radius: 10px; padding: 12px 14px;
      font-size: 12.5px; line-height: 1.65; color: var(--text);
      display: none;
    }
    .screen-analysis-box.visible { display: block; }
    .screen-analysis-label {
      font-family: var(--mono); font-size: 10px; color: var(--cyan);
      letter-spacing: .08em; text-transform: uppercase; margin-bottom: 6px;
    }

    /* ══════════════════════════════
       IMAGE PROVIDER BAR
    ══════════════════════════════ */
    .img-provider-bar {
      display: flex; align-items: center; gap: 10px;
      background: rgba(52,188,255,.045);
      border: 1px solid var(--line);
      border-radius: var(--rb);
      padding: 8px 14px;
      font-size: 11.5px;
    }
    .img-provider-label { color: var(--muted); }
    .img-provider-badge {
      font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
      font-size: 10.5px; padding: 2px 8px;
      border-radius: 99px;
      background: rgba(52,188,255,.15);
      color: var(--cyan);
      border: 1px solid rgba(52,188,255,.3);
    }
    .img-provider-badge.stability { background: rgba(160,100,255,.15); color: #c084fc; border-color: rgba(160,100,255,.35); }
    .img-provider-badge.openai    { background: rgba(74,222,128,.10); color: #4ade80;  border-color: rgba(74,222,128,.3); }

    /* hide provider-specific fields by default — JS toggles them */
    .stability-only { display: none; }
    .openai-only    { display: none; }
  </style>
</head>
<body>

<!-- BG LAYERS -->
<canvas id="bg-canvas"></canvas>
<div id="cursor-aura"></div>
<div class="grid-layer"></div>
<div class="noise"></div>
<div class="ambient a1"></div>
<div class="ambient a2"></div>
<div class="ambient a3"></div>
<div class="scanline"></div>

<!-- DRAWER -->
<div class="drawer-overlay" id="overlay"></div>
<div class="drawer" id="drawer">
  <div class="drawer-head">
    <h2>⚙ Configurações</h2>
    <button class="close-btn" id="closeDrawer">✕</button>
  </div>
  <div class="drawer-body">
    <div class="dsec">// Identidade</div>
    <div class="dfield"><label>Nome do Agente</label><input type="text" id="cfg-name" placeholder="Luna Agent"></div>
    <div class="dfield"><label>Tagline</label><input type="text" id="cfg-tagline" placeholder="assistente operacional · engenharia · automação · segurança"></div>

    <div class="dsep"></div>
    <div class="dsec">// Conexão API</div>
    <div class="dfield"><label>Endpoint</label><input type="text" id="cfg-endpoint" placeholder="/chat"></div>
    <div class="dfield"><label>Método HTTP</label>
      <select id="cfg-method"><option value="POST">POST</option><option value="GET">GET</option><option value="PUT">PUT</option></select>
    </div>
    <div class="dfield"><label>Campo da mensagem no payload</label><input type="text" id="cfg-field" placeholder="message"></div>
    <div class="dfield"><label>Caminho da resposta (ex: response.text)</label><input type="text" id="cfg-resp-path" placeholder="response.text"></div>
    <div class="dfield"><label>Headers customizados (JSON)</label><textarea id="cfg-headers" rows="3" placeholder='{"Authorization": "Bearer token"}'></textarea></div>

    <div class="dsep"></div>
    <div class="dsec">// Interface</div>
    <div class="dfield"><label>Workspace ativo</label><input type="text" id="cfg-project" placeholder="luna-agent"></div>
    <div class="dfield"><label>Missão atual</label><input type="text" id="cfg-mission" placeholder="Execução assistida e rastreabilidade real"></div>
    <div class="dfield"><label>Stack (footer)</label><input type="text" id="cfg-stack" placeholder="FastAPI · Docker · GPT-4o"></div>
    <div class="dfield"><label>Placeholder do input</label><input type="text" id="cfg-placeholder" placeholder="Ex.: Luna, qual o próximo passo da missão?"></div>

    <button class="save-btn" id="saveConfig">Salvar e Aplicar</button>
  </div>
</div>

<!-- TOAST -->
<div id="toast">✓ Configuração salva</div>

<!-- APP -->
<div class="root">
  <div class="shell">

    <!-- TOPBAR -->
    <div class="topbar">
      <div class="brand">
        <div class="logo-ring">
          <!-- outer ring -->
          <svg class="ring-svg" viewBox="0 0 66 66" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="33" cy="33" r="31" stroke="url(#rg1)" stroke-width="1" stroke-dasharray="4 7" stroke-linecap="round"/>
            <defs>
              <linearGradient id="rg1" x1="0" y1="0" x2="66" y2="66" gradientUnits="userSpaceOnUse">
                <stop stop-color="#34bcff" stop-opacity="0.65"/>
                <stop offset="0.5" stop-color="#1475e8" stop-opacity="0.18"/>
                <stop offset="1" stop-color="#34bcff" stop-opacity="0.65"/>
              </linearGradient>
            </defs>
          </svg>
          <!-- inner ring counter-rotating -->
          <svg class="ring-svg-2" viewBox="0 0 66 66" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="33" cy="33" r="24" stroke="url(#rg2)" stroke-width="0.8" stroke-dasharray="2 10" stroke-linecap="round"/>
            <defs>
              <linearGradient id="rg2" x1="0" y1="0" x2="66" y2="66" gradientUnits="userSpaceOnUse">
                <stop stop-color="#58d4ff" stop-opacity="0.5"/>
                <stop offset="1" stop-color="#1475e8" stop-opacity="0.1"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="logo-inner">☾</div>
        </div>
        <div class="brand-copy">
          <h1 id="ui-name">Luna Agent</h1>
          <div class="tagline">// assistente operacional · <em>engenharia</em> · <em>automação</em> · <em>segurança</em></div>
        </div>
      </div>

      <div class="top-right">
        <div class="exec-target-group">
          <div class="exec-btns">
            <button class="exec-btn active" id="execBtnVps" onclick="setExecTarget('vps')">VPS</button>
            <button class="exec-btn"        id="execBtnLocal" onclick="setExecTarget('local')">LOCAL</button>
          </div>
          <div class="bridge-indicator" id="bridgeIndicator" title="Worker local / Bridge SSH">
            <span class="bridge-dot" id="bridgeDot"></span>
            <span id="bridgeStatusLabel">worker</span>
            <span id="workerHostnameTag" style="display:none;font-size:9px;color:var(--sky);margin-left:4px;font-family:var(--mono)"></span>
          </div>
        </div>
        <div class="status-pill">
          <span class="dot"></span>
          ONLINE · VPS ATIVA
        </div>
        <button class="cog-btn" id="openDrawer">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          CONFIG
        </button>
      </div>
    </div>

    <!-- MAIN CARD -->
    <div class="card">
      <div class="card-brackets">
        <div class="cb cb-tl"></div><div class="cb cb-tr"></div>
        <div class="cb cb-bl"></div><div class="cb cb-br"></div>
      </div>
      <div class="card-shimmer"></div>
      <div class="card-beam"></div>

      <!-- INFO BAND -->
      <div class="info-band">
        <div class="info-cell ws-cell" id="wsSelectorCell" title="Clique para trocar workspace">
          <div class="ic-label">Workspace ativo</div>
          <div class="ic-value hi" id="ui-project">luna-agent <span class="ws-arrow">▾</span></div>
          <div class="ws-dropdown" id="wsDropdown">
            <!-- populated by JS -->
          </div>
        </div>
        <div class="info-cell">
          <div class="ic-label">Missão atual</div>
          <div class="ic-value sm" id="ui-mission">Execução assistida e rastreabilidade real</div>
        </div>
        <div class="info-cell live">
          <div class="ic-label">Status do sistema</div>
          <div class="ic-value hi" id="ui-sys-status">Base viva · Respondendo</div>
        </div>
      </div>

      <!-- ABOUT -->
      <div class="about-wrap">
        <div class="sec-head"><span class="sec-label">// sistema</span><div class="sec-rule"></div></div>
        <div class="about-grid">
          <div class="pbox">
            <h3>Núcleo operacional</h3>
            <p>Assistente técnico para engenharia, automação e segurança. Contexto persistente, execução assistida e rastreabilidade real em cada ciclo.</p>
            <div class="tags">
              <span class="tag">Modo Dev</span>
              <span class="tag">Modo Hunter</span>
              <span class="tag">Agente ativo</span>
              <span class="tag">FastAPI</span>
              <span class="tag">Docker</span>
            </div>
          </div>
          <div class="pbox" style="display:flex;flex-direction:column;justify-content:space-between">
            <div>
              <h3>Estado do sistema</h3>
              <p>Plano carregado, guards ativos, memória persistente entre sessões. Sistema pronto para receber missão.</p>
            </div>
            <div class="stat-row">
              <div class="stat-item"><div class="stat-n" id="stat-mode" style="cursor:pointer;transition:color .2s" title="Modo atual">DEV</div><div class="stat-l">Modo</div></div>
              <div class="stat-item"><div class="stat-n">01</div><div class="stat-l">VPS</div></div>
              <div class="stat-item"><div class="stat-n">24h</div><div class="stat-l">Uptime</div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- PANEL NAVIGATION -->
      <div class="panel-nav" id="panelNav">
        <button class="panel-tab active" data-panel="chat">
          <span class="tab-icon">💬</span> Chat
        </button>
        <button class="panel-tab" data-panel="agent">
          <span class="tab-icon">⬡</span> Agente
        </button>
        <button class="panel-tab" data-panel="images" style="color:var(--dim)">
          <span class="tab-icon">🎨</span> Lab · Imagens
          <span class="tab-badge" id="galleryCountBadge" style="display:none">0</span>
        </button>
      </div>

      <!-- ═══════ PANEL: CHAT ═══════ -->
      <div id="panel-chat" class="panel-content active">

      <!-- CONTEXT PANEL (workspace context, toggleable) -->
      <div class="ctx-panel" id="ctxPanel">
        <div class="ctx-inner">
          <div class="sec-head"><span class="sec-label">// contexto do workspace</span><div class="sec-rule"></div></div>
          <div class="ctx-cols">
            <div class="ctx-box">
              <h4>Status atual</h4>
              <pre id="ctxStatus">Carregando...</pre>
            </div>
            <div class="ctx-box">
              <h4>Próximos passos</h4>
              <pre id="ctxNextSteps">Carregando...</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- APPROVAL PANEL (agent actions pending approval) -->
      <div class="approval-panel" id="approvalPanel">
        <div class="approval-head">
          <span>⚠ Ações aguardando aprovação</span>
          <button class="ctx-toggle-btn" id="refreshApprovals" style="color:var(--amber)">↻ atualizar</button>
        </div>
        <div class="approval-list" id="approvalList">
          <!-- populated by JS -->
        </div>
      </div>

      <!-- CHAT -->
      <div class="chat-wrap">
        <div class="sec-head"><span class="sec-label">// terminal</span><div class="sec-rule"></div></div>
        <div class="chat-shell">

          <div class="chat-bar">
            <div class="chat-bar-left">
              <div class="chat-led"></div>
              <div class="chat-bar-title" id="ui-chat-title">Luna · Chat direto</div>
            </div>
            <div class="chat-modes" id="chatModes">
              <button class="mode-tab active" data-mode="dev">Dev</button>
              <button class="mode-tab" data-mode="hunter">Hunter</button>
              <button class="mode-tab" data-mode="solana">Solana</button>
              <button class="mode-tab" data-mode="recon">Recon</button>
              <button class="mode-tab" data-mode="code_review">Code Review</button>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
              <button class="ctx-toggle-btn" id="ctxToggleBtn" title="Mostrar/ocultar contexto do workspace">📋 CONTEXTO</button>
              <div class="chat-bar-meta" id="chatBarMeta">FASE 2 · GUARDS ATIVOS</div>
            </div>
          </div>

          <div class="chat-msgs" id="chatMsgs">
            <div class="chat-empty" id="emptyState">
              <div class="chat-empty-icon">☾</div>
              <div class="chat-empty-txt">Luna aguarda seu comando</div>
            </div>
          </div>

          <div class="input-area">
            <div class="input-row">
              <div class="ta-wrap">
                <textarea id="msgInput" rows="1" placeholder="Ex.: Luna, qual o próximo passo da missão?"></textarea>
                <span class="char-count" id="charCount"></span>
              </div>
              <button class="send-btn" id="sendBtn" title="Ctrl+Enter para enviar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
                <div class="send-spinner" id="sendSpinner">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M12 2a10 10 0 0 1 10 10"/>
                  </svg>
                </div>
              </button>
            </div>
            <div class="input-meta">
              <div class="input-hint"><em>Ctrl+Enter</em> enviar &nbsp;·&nbsp; <em>Shift+Enter</em> nova linha</div>
              <div style="display:flex;align-items:center;gap:10px;">
                <button class="mode-tab" id="newSessionBtn" type="button">Nova sessão</button>
                <div class="input-hint" id="modelLabel" style="color:var(--dim)"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      </div><!-- /panel-chat -->

      <!-- ═══════ PANEL: IMAGENS ═══════ -->
      <div id="panel-images" class="panel-content">
        <div class="img-panel-wrap">

          <!-- Provider banner -->
          <div class="img-provider-bar">
            <div style="display:flex;align-items:center;gap:10px">
              <span class="img-provider-label">Provider:</span>
              <span class="img-provider-badge" id="imgProviderBadge">—</span>
            </div>
            <span class="img-provider-note" id="imgProviderNote" style="color:var(--muted);font-size:10.5px"></span>
          </div>

          <!-- Image mode tabs -->
          <div class="img-modes">
            <button class="img-mode-btn active" data-imgmode="generate">✦ Gerar</button>
            <button class="img-mode-btn" data-imgmode="edit">✎ Editar</button>
            <button class="img-mode-btn" data-imgmode="variation">⊞ Variações</button>
          </div>

          <!-- SUB: GERAR -->
          <div id="imgSub-generate" class="img-sub active">
            <div class="img-form">
              <div class="img-prompt-wrap">
                <textarea class="img-prompt" id="imgPrompt" rows="2"
                  placeholder="Descreva a imagem em detalhe... Ex.: retrato cinemático, iluminação dramática, 8k, hyperrealistic"></textarea>
              </div>

              <!-- Negative prompt (Stability) -->
              <div class="img-prompt-wrap stability-only" id="genNegWrap">
                <textarea class="img-prompt" id="imgNegativePrompt" rows="1"
                  placeholder="Negative prompt: o que NÃO deve aparecer... Ex.: blurry, low quality, watermark, text"></textarea>
              </div>

              <!-- OpenAI controls -->
              <div class="img-controls openai-only" id="genOpenAIControls">
                <div class="img-ctrl">
                  <label>Tamanho</label>
                  <select id="imgSizeOAI">
                    <option value="1024x1024">1024 × 1024</option>
                    <option value="1792x1024">1792 × 1024 (landscape)</option>
                    <option value="1024x1792">1024 × 1792 (portrait)</option>
                  </select>
                </div>
                <div class="img-ctrl">
                  <label>Qualidade</label>
                  <select id="imgQuality">
                    <option value="standard">Standard</option>
                    <option value="hd">HD</option>
                  </select>
                </div>
                <div class="img-ctrl">
                  <label>Estilo</label>
                  <select id="imgStyle">
                    <option value="vivid">Vivid</option>
                    <option value="natural">Natural</option>
                  </select>
                </div>
              </div>

              <!-- Stability controls -->
              <div class="img-controls stability-only" id="genStabilityControls">
                <div class="img-ctrl">
                  <label>Tamanho</label>
                  <select id="imgSizeSD">
                    <option value="1024x1024">1024 × 1024 (1:1)</option>
                    <option value="1344x768">1344 × 768 (16:9)</option>
                    <option value="1216x832">1216 × 832 (3:2)</option>
                    <option value="1152x896">1152 × 896 (4:3)</option>
                    <option value="896x1152">896 × 1152 (3:4)</option>
                    <option value="832x1216">832 × 1216 (2:3)</option>
                    <option value="768x1344">768 × 1344 (9:16)</option>
                    <option value="1536x640">1536 × 640 (21:9)</option>
                  </select>
                </div>
                <div class="img-ctrl">
                  <label>Style preset</label>
                  <select id="imgStylePreset">
                    <option value="none">none</option>
                    <option value="photographic">photographic</option>
                    <option value="cinematic">cinematic</option>
                    <option value="anime">anime</option>
                    <option value="digital-art">digital-art</option>
                    <option value="fantasy-art">fantasy-art</option>
                    <option value="neon-punk">neon-punk</option>
                    <option value="3d-model">3d-model</option>
                    <option value="analog-film">analog-film</option>
                    <option value="comic-book">comic-book</option>
                    <option value="enhance">enhance</option>
                    <option value="line-art">line-art</option>
                    <option value="origami">origami</option>
                    <option value="pixel-art">pixel-art</option>
                    <option value="tile-texture">tile-texture</option>
                  </select>
                </div>
