# Backend Configuration
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Local inference
OLLAMA_BASE_URL=http://localhost:11434/v1
LUNA_MODEL=luna-cyber-fast
LUNA_ZERO_CLOUD=true
LUNA_VISION_MODEL=
LUNA_PROJECTS_DIR=D:\LunaCyber\projects

# Supervised executor
# Disabled by default. Model tool-calling remains hard-locked separately.
LUNA_SUPERVISED_EXECUTOR=false
LUNA_EXEC_ALLOW_L0=true
LUNA_EXEC_ALLOW_L1=true
LUNA_EXEC_ALLOW_L2=false
LUNA_EXEC_ALLOW_L3=false
LUNA_EXEC_TIMEOUT_SECONDS=120
LUNA_EXEC_MAX_OUTPUT_BYTES=2097152

# Execution backend
# Keep local-subprocess while configuring. To bind approved actions to the Kali VM,
# set LUNA_EXEC_BACKEND=kali-ssh and fill the SSH contract below.
LUNA_EXEC_BACKEND=local-subprocess
LUNA_KALI_SSH_HOST=
LUNA_KALI_SSH_USER=kali
LUNA_KALI_SSH_PORT=22
LUNA_KALI_SSH_IDENTITY=
LUNA_KALI_SSH_KNOWN_HOSTS=
LUNA_KALI_SSH_HOST_KEY_POLICY=strict
LUNA_KALI_SSH_CONNECT_TIMEOUT=10

# Blockchain
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_NETWORK=mainnet

# App Configuration
VITE_APP_ENV=development
VITE_LOG_LEVEL=debug
