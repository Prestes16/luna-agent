              <div class="upload-zone" id="varUploadZone" style="max-width:420px">
                <input type="file" id="varImageInput" accept="image/png,image/jpeg,image/webp">
                <div class="upload-icon">⊞</div>
                <div class="upload-label">Imagem base para variações</div>
                <div class="upload-hint">PNG/JPG · máx 4MB</div>
