            <div class="img-result" id="imgEditResult">
              <div class="sec-head" style="margin-top:20px"><span class="sec-label">// resultado da edição</span><div class="sec-rule"></div></div>
              <div class="img-result-inner">
                <img class="img-result-img" id="imgEditResultImg" src="" alt="Imagem editada">
