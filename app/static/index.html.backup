                <textarea class="agent-plan-textarea" id="agentObjective" rows="2"
                  placeholder="Ex.: Listar arquivos do workspace, verificar logs de erro, aplicar patch no main.py..."></textarea>
                <select class="agent-plan-select" id="agentModeSelect">
                  <option value="propose">Propose</option>
                  <option value="execute_safe">Execute safe</option>
                  <option value="observe">Observe</option>
                </select>
                <input class="agent-plan-input" id="localRootInput" type="text"
                  placeholder="Raiz local (ex: /mnt/d/luna-agent)"
                  style="display:none" title="Diretório raiz no PC local">
                <button class="agent-plan-btn" id="agentPlanBtn">⬡ Planejar</button>
              </div>
