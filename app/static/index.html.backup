  });
});

/* ══════════════════════════════════════════════
   IMAGE GENERATION
══════════════════════════════════════════════ */
let lastGeneratedId = null;

async function generateImage() {
  const prompt  = document.getElementById('imgPrompt')?.value.trim();
  if (!prompt) { showToast('Escreva um prompt primeiro'); return; }

  const btn     = document.getElementById('imgGenerateBtn');
  const progress = document.getElementById('imgProgress');
  const bar      = document.getElementById('imgProgressBar');

  btn?.classList.add('generating'); btn.disabled = true;
  progress?.classList.add('active');

  // Animate progress bar
  let pct = 0;
  const pTimer = setInterval(() => {
    pct = Math.min(pct + (pct < 60 ? 6 : 1.5), 88);
    if (bar) bar.style.width = pct + '%';
  }, 700);

  try {
    const provider = window._imgProvider || 'openai';
    const payload = { prompt };
    if (provider === 'stability') {
      payload.size           = document.getElementById('imgSizeSD')?.value   || '1024x1024';
      const negPrompt        = document.getElementById('imgNegativePrompt')?.value.trim();
      if (negPrompt)         payload.negative_prompt = negPrompt;
      payload.steps          = parseInt(document.getElementById('imgSteps')?.value)    || 30;
      payload.cfg_scale      = parseFloat(document.getElementById('imgCfgScale')?.value) || 7;
      const stylePreset      = document.getElementById('imgStylePreset')?.value;
      if (stylePreset && stylePreset !== 'none') payload.style_preset = stylePreset;
      const seed             = parseInt(document.getElementById('imgSeed')?.value);
      if (!isNaN(seed) && seed > 0) payload.seed = seed;
    } else {
      payload.size    = document.getElementById('imgSizeOAI')?.value   || '1024x1024';
      payload.quality = document.getElementById('imgQuality')?.value   || 'standard';
      payload.style   = document.getElementById('imgStyle')?.value     || 'vivid';
    }

    const res  = await fetch('/image/generate', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await res.json();

    clearInterval(pTimer);
    if (bar) bar.style.width = '100%';
    setTimeout(() => { progress?.classList.remove('active'); if(bar) bar.style.width='0%'; }, 600);

    if (!res.ok || !data.success) {
      showToast('Erro: ' + (data.detail || data.response?.error || 'falha na geração'));
      return;
    }

    const r = data.response;
    lastGeneratedId = r.image_id;

    const resultEl = document.getElementById('imgGenerateResult');
    const imgEl    = document.getElementById('imgResultImg');
    const metaEl   = document.getElementById('imgResultMeta');

    if (imgEl)  imgEl.src = r.url + '?t=' + Date.now();
    if (metaEl) {
      const prov = r.provider || window._imgProvider || 'openai';
      const extraMeta = prov === 'stability'
        ? `<strong>Provider:</strong> Stability AI SDXL · <strong>Tamanho:</strong> ${r.size}<br>`
        : `<strong>Tamanho:</strong> ${r.size} · <strong>Qualidade:</strong> ${r.quality} · <strong>Estilo:</strong> ${r.style}<br>`;
      metaEl.innerHTML = `
        <strong>Prompt:</strong> ${escapeHtml(r.prompt)}<br>
        ${r.prompt_revised && r.prompt_revised !== r.prompt ? `<strong>Prompt revisado:</strong> ${escapeHtml(r.prompt_revised)}<br>` : ''}
        ${extraMeta}
        <strong>ID:</strong> ${r.image_id}
      `;
    }
    resultEl?.classList.add('visible');
    resultEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    loadGallery();
    showToast('Imagem gerada com sucesso!');

  } catch(e) {
    clearInterval(pTimer);
    showToast('Erro de conexão: ' + e.message);
  } finally {
    btn?.classList.remove('generating'); btn.disabled = false;
  }
}

document.getElementById('imgGenerateBtn')?.addEventListener('click', generateImage);
document.getElementById('imgPrompt')?.addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.ctrlKey) { e.preventDefault(); generateImage(); }
});

// Download button
document.getElementById('imgDownloadBtn')?.addEventListener('click', () => {
  const img = document.getElementById('imgResultImg');
  if (!img?.src) return;
  const a = document.createElement('a');
  a.href = img.src; a.download = `luna-${lastGeneratedId||'img'}.png`; a.click();
});

// Send to Edit
document.getElementById('imgSendToEditBtn')?.addEventListener('click', () => {
  if (!lastGeneratedId) return;
  fetchImageAsFile(lastGeneratedId, 'editImageInput', 'editImageName', 'editUploadZone');
  document.querySelector('[data-imgmode="edit"]')?.click();
});

// Send to Variation
document.getElementById('imgSendToVariationBtn')?.addEventListener('click', () => {
  if (!lastGeneratedId) return;
  fetchImageAsFile(lastGeneratedId, 'varImageInput', 'varImageName', 'varUploadZone');
  document.querySelector('[data-imgmode="variation"]')?.click();
});

// Delete result
document.getElementById('imgDeleteResultBtn')?.addEventListener('click', async () => {
  if (!lastGeneratedId) return;
  await deleteImageById(lastGeneratedId);
  document.getElementById('imgGenerateResult')?.classList.remove('visible');
  lastGeneratedId = null;
});

/* ══════════════════════════════════════════════
   IMAGE EDIT
══════════════════════════════════════════════ */
setupUploadZone('editImageInput', 'editImageName', 'editUploadZone');
setupUploadZone('maskImageInput', 'maskImageName', 'maskUploadZone');

let lastEditId = null;

document.getElementById('imgEditBtn')?.addEventListener('click', async () => {
  const imgInput  = document.getElementById('editImageInput');
  const editPrompt = document.getElementById('editPrompt')?.value.trim();
  if (!imgInput?.files?.length) { showToast('Selecione uma imagem para editar'); return; }
  if (!editPrompt) { showToast('Escreva o que deve ser editado'); return; }

  const btn = document.getElementById('imgEditBtn');
  const progress = document.getElementById('editProgress');
  const bar      = document.getElementById('editProgressBar');
  btn?.classList.add('generating'); btn.disabled = true;
  progress?.classList.add('active');

  let pct = 0;
  const pTimer = setInterval(() => {
    pct = Math.min(pct + (pct < 60 ? 5 : 1.2), 88);
    if (bar) bar.style.width = pct + '%';
  }, 800);

  try {
    const fd = new FormData();
    fd.append('prompt', editPrompt);
    fd.append('image',  imgInput.files[0]);
    const maskInput = document.getElementById('maskImageInput');
    if (maskInput?.files?.length) fd.append('mask', maskInput.files[0]);
    fd.append('size', document.getElementById('editSize')?.value || '1024x1024');
    const editNeg = document.getElementById('editNegativePrompt')?.value.trim();
    if (editNeg) fd.append('negative_prompt', editNeg);

    const res  = await fetch('/image/edit', { method: 'POST', body: fd });
    const data = await res.json();

    clearInterval(pTimer);
    if (bar) bar.style.width = '100%';
    setTimeout(() => { progress?.classList.remove('active'); if(bar) bar.style.width='0%'; }, 600);

    if (!res.ok || !data.success) {
      showToast('Erro: ' + (data.detail || 'falha na edição'));
      return;
    }

    const r = data.response;
    lastEditId = r.image_id;
    const resultEl = document.getElementById('imgEditResult');
    const imgEl    = document.getElementById('imgEditResultImg');
    if (imgEl) imgEl.src = r.url + '?t=' + Date.now();
    resultEl?.classList.add('visible');
    resultEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    loadGallery();
    showToast('Imagem editada com sucesso!');

  } catch(e) {
    clearInterval(pTimer);
    showToast('Erro: ' + e.message);
  } finally {
    btn?.classList.remove('generating'); btn.disabled = false;
  }
});

document.getElementById('editDownloadBtn')?.addEventListener('click', () => {
  const img = document.getElementById('imgEditResultImg');
  if (!img?.src) return;
  const a = document.createElement('a');
  a.href = img.src; a.download = `luna-edit-${lastEditId||'img'}.png`; a.click();
});

document.getElementById('editDeleteBtn')?.addEventListener('click', async () => {
  if (!lastEditId) return;
  await deleteImageById(lastEditId);
  document.getElementById('imgEditResult')?.classList.remove('visible');
  lastEditId = null;
});

/* ══════════════════════════════════════════════
   IMAGE VARIATION
══════════════════════════════════════════════ */
setupUploadZone('varImageInput', 'varImageName', 'varUploadZone');

document.getElementById('imgVariationBtn')?.addEventListener('click', async () => {
  const imgInput = document.getElementById('varImageInput');
  if (!imgInput?.files?.length) { showToast('Selecione uma imagem base'); return; }

  const btn = document.getElementById('imgVariationBtn');
  const progress = document.getElementById('varProgress');
  const bar      = document.getElementById('varProgressBar');
  btn?.classList.add('generating'); btn.disabled = true;
  progress?.classList.add('active');

  let pct = 0;
  const pTimer = setInterval(() => {
    pct = Math.min(pct + (pct < 60 ? 5 : 1.2), 88);
    if (bar) bar.style.width = pct + '%';
  }, 800);

  try {
    const fd = new FormData();
    fd.append('image', imgInput.files[0]);
    const varProvider = window._imgProvider || 'openai';
    if (varProvider === 'stability') {
      fd.append('size', document.getElementById('varSizeSD')?.value || '1024x1024');
      const varPrompt = document.getElementById('varPrompt')?.value.trim();
      if (varPrompt) fd.append('prompt', varPrompt);
      fd.append('image_strength', document.getElementById('varStrength')?.value || '0.35');
    } else {
      fd.append('n',    document.getElementById('varN')?.value    || '2');
      fd.append('size', document.getElementById('varSizeOAI')?.value || '1024x1024');
    }

    const res  = await fetch('/image/variation', { method: 'POST', body: fd });
    const data = await res.json();

    clearInterval(pTimer);
    if (bar) bar.style.width = '100%';
    setTimeout(() => { progress?.classList.remove('active'); if(bar) bar.style.width='0%'; }, 600);

    if (!res.ok || !data.success) {
      showToast('Erro: ' + (data.detail || 'falha na variação'));
      return;
    }

    const images = data.response?.images || [];
    const grid   = document.getElementById('varResultGrid');
    const result = document.getElementById('imgVarResult');
    if (grid) {
      grid.innerHTML = '';
      images.forEach(img => {
        const card = document.createElement('div');
        card.className = 'gallery-card';
        card.innerHTML = `
          <img class="gallery-img" src="${img.url}?t=${Date.now()}" alt="variação">
          <div class="gallery-card-meta">
            <div class="gallery-card-footer">
              <span class="gallery-type-badge">variação</span>
              <button class="gallery-del-btn" data-id="${img.image_id}">🗑</button>
            </div>
          </div>
        `;
        card.querySelector('.gallery-del-btn').onclick = async (e) => {
          e.stopPropagation();
          await deleteImageById(img.image_id);
          card.remove();
        };
        grid.appendChild(card);
      });
      result.style.display = 'block';
    }

    loadGallery();
    showToast(`${images.length} variação(ões) gerada(s)!`);

  } catch(e) {
    clearInterval(pTimer);
    showToast('Erro: ' + e.message);
  } finally {
    btn?.classList.remove('generating'); btn.disabled = false;
  }
});

/* ══════════════════════════════════════════════
   IMAGE PROVIDER
══════════════════════════════════════════════ */
async function loadImageProvider() {
  try {
    const res  = await fetch('/image/provider');
    if (!res.ok) return;
    const data = await res.json();
    const prov = data.provider || 'openai';
    window._imgProvider = prov;

    const badge = document.getElementById('imgProviderBadge');
    const note  = document.getElementById('imgProviderNote');
    if (badge) {
      badge.textContent = prov === 'stability' ? 'Stability AI SDXL' : 'OpenAI DALL-E';
      badge.className   = 'img-provider-badge ' + prov;
    }
    if (note) {
      note.textContent = prov === 'stability'
        ? 'Modelos SDXL — sem filtro de conteúdo'
        : 'DALL-E 3 — filtragem de conteúdo ativa';
    }

    // show/hide provider-specific fields
    document.querySelectorAll('.stability-only').forEach(el => {
      el.style.display = prov === 'stability' ? '' : 'none';
    });
    document.querySelectorAll('.openai-only').forEach(el => {
      el.style.display = prov === 'openai' ? '' : 'none';
    });
  } catch(_) {}
}

/* ══════════════════════════════════════════════
   GALLERY
══════════════════════════════════════════════ */
async function loadGallery() {
  const grid  = document.getElementById('galleryGrid');
  const badge = document.getElementById('galleryCountBadge');
  try {
    const res = await fetch('/image/gallery?limit=60');
    if (!res.ok) {
      if (grid) grid.innerHTML = '<div class="gallery-empty">Módulo de imagens indisponível neste build.</div>';
      return;
    }
    const data = await res.json();
    if (!data.success) return;

    const images = data.response?.images || [];

    if (badge) {
      badge.textContent = images.length;
      badge.style.display = images.length > 0 ? '' : 'none';
    }

    if (!grid) return;
    if (images.length === 0) {
      grid.innerHTML = '<div class="gallery-empty">Nenhuma imagem ainda. Gere algo!</div>';
      return;
    }

    grid.innerHTML = '';
    images.forEach(img => {
      const card = document.createElement('div');
      card.className = 'gallery-card';
      const prompt = img.prompt || img.type || '';
      card.innerHTML = `
        <img class="gallery-img" src="${img.url}?t=${img.ts||''}" alt="imagem" loading="lazy">
        <div class="gallery-card-meta">
          <div class="gallery-card-prompt" title="${escapeHtml(prompt)}">${escapeHtml(prompt)}</div>
          <div class="gallery-card-footer">
            <span class="gallery-type-badge">${img.type || 'img'}</span>
            <button class="gallery-del-btn" title="Deletar" data-id="${img.image_id}">🗑</button>
          </div>
        </div>
      `;

      // Click to view full size
      card.addEventListener('click', (e) => {
        if (e.target.closest('.gallery-del-btn')) return;
        window.open(img.url, '_blank');
      });

      card.querySelector('.gallery-del-btn').addEventListener('click', async (e) => {
        e.stopPropagation();
        await deleteImageById(img.image_id);
        card.remove();
        const remaining = grid.querySelectorAll('.gallery-card').length;
        if (remaining === 0) grid.innerHTML = '<div class="gallery-empty">Galeria vazia.</div>';
        if (badge) badge.textContent = remaining;
      });

      grid.appendChild(card);
    });

  } catch(e) {
    if (grid && grid.children.length === 0) {
      grid.innerHTML = '<div class="gallery-empty">Módulo de imagens indisponível.</div>';
    }
    console.warn('[gallery]', e);
  }
}

async function deleteImageById(image_id) {
  try {
    await fetch(`/image/${image_id}`, { method: 'DELETE' });
    showToast('Imagem deletada');
  } catch(e) { console.warn('[delete]', e); }
}

document.getElementById('refreshGalleryBtn')?.addEventListener('click', loadGallery);

/* ══════════════════════════════════════════════
   UPLOAD ZONE HELPER
══════════════════════════════════════════════ */
function setupUploadZone(inputId, nameId, zoneId) {
  const input = document.getElementById(inputId);
  const nameEl = document.getElementById(nameId);
  const zone  = document.getElementById(zoneId);
  if (!input) return;

  input.addEventListener('change', () => {
    const file = input.files?.[0];
    if (file) {
      if (nameEl) nameEl.textContent = file.name;
      zone?.classList.add('has-file');
    }
  });

  // Drag and drop
  zone?.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('has-file'); });
  zone?.addEventListener('dragleave', () => { if (!input.files?.length) zone.classList.remove('has-file'); });
  zone?.addEventListener('drop', e => {
    e.preventDefault();
    if (e.dataTransfer.files?.length) {
      const dt = new DataTransfer();
      dt.items.add(e.dataTransfer.files[0]);
      input.files = dt.files;
      if (nameEl) nameEl.textContent = e.dataTransfer.files[0].name;
      zone?.classList.add('has-file');
    }
  });
}

async function fetchImageAsFile(imageId, inputId, nameId, zoneId) {
  try {
    const res   = await fetch(`/image/file/${imageId}`);
    const blob  = await res.blob();
    const file  = new File([blob], `luna-${imageId}.png`, { type: 'image/png' });
    const dt    = new DataTransfer();
    dt.items.add(file);
    const input = document.getElementById(inputId);
    const nameEl = document.getElementById(nameId);
    const zone   = document.getElementById(zoneId);
    if (input) { input.files = dt.files; }
    if (nameEl) nameEl.textContent = file.name;
    zone?.classList.add('has-file');
  } catch(e) { console.warn('[fetchImageAsFile]', e); }
}

/* ══════════════════════════════════════════════
   AGENT PANEL V2
══════════════════════════════════════════════ */

// ── loadAgentState: atualiza info-band + state display ──
async function loadAgentState() {
  try {
    const res  = await fetch('/agent/state');
    const data = await res.json();
    if (!data.success) return;

    const r   = data.response || {};
    const cfg = r.config || {};
    const plan = r.last_plan;
    const workerOnline = r.worker_online || false;
    const worker = r.worker || null;
    const execTarget = r.execution_target || cfg.execution_target || 'vps';

    // Atualiza info-band
    const missionEl = document.getElementById('ui-mission');
    if (missionEl) {
      const obj = plan?.objective
        ? `Modo ${(cfg.mode||'dev').toUpperCase()} · ${plan.objective.slice(0,50)}${plan.objective.length>50?'…':''}`
        : 'Execução assistida e rastreabilidade real';
      missionEl.textContent = obj;
    }
    const statusEl = document.getElementById('ui-sys-status');
    const workerPart = workerOnline ? ` · Worker ${worker?.hostname || 'online'}` : '';
    if (statusEl) statusEl.textContent = `${(cfg.mode||'dev').toUpperCase()} · ${execTarget.toUpperCase()}${workerPart}`;
    const statMode = document.getElementById('stat-mode');
    if (statMode) statMode.textContent = (cfg.mode||'dev').toUpperCase();

    // Update worker dot in top bar
    const dot   = document.getElementById('bridgeDot');
    const label = document.getElementById('bridgeStatusLabel');
    const hosTag = document.getElementById('workerHostnameTag');
    if (workerOnline) {
      if (dot)   dot.className = 'bridge-dot online';
      if (label) label.textContent = 'worker online';
      if (hosTag) { hosTag.textContent = worker?.hostname || ''; hosTag.style.display = ''; }
    } else if (execTarget === 'local') {
      if (dot)   dot.className = 'bridge-dot offline';
      if (label) label.textContent = 'worker offline';
      if (hosTag) hosTag.style.display = 'none';
    }

    // Atualiza state display
    const display = document.getElementById('agentStateDisplay');
    if (display) {
      const lines = [
        `── CONFIGURAÇÃO ──────────────────────────`,
        `  Modo:         ${cfg.mode || '-'}`,
        `  Target:       ${execTarget.toUpperCase()}${execTarget === 'local' ? ` (${cfg.local_target_root || '?'})` : ` (${cfg.target_root || '?'})`}`,
        `  Allow write:  ${cfg.allow_write}`,
        `  Allow run:    ${cfg.allow_run_command}`,
        ``,
        `── WORKER LOCAL ───────────────────────────`,
        `  Status:       ${workerOnline ? '🟢 ONLINE' : '🔴 OFFLINE'}`,
        workerOnline ? `  Hostname:     ${worker?.hostname || '-'}` : `  Dica: python luna_worker.py`,
        workerOnline ? `  Capabilities: ${(worker?.capabilities||[]).join(', ') || '-'}` : '',
        ``,
        `── ÚLTIMO PLANO ───────────────────────────`,
      ].filter(l => l !== undefined);
      if (plan) {
        lines.push(
          `  Sessão:       ${plan.session_id || '-'}`,
          `  Objetivo:     ${plan.objective || '-'}`,
          `  Ações:        ${(plan.proposed_actions||[]).length} proposta(s)`,
          `  Parada:       ${plan.stop_reason || '-'}`,
        );
      } else {
        lines.push(`  Nenhum plano carregado.`);
      }
      display.textContent = lines.join('\n');
      display.className = 'agent-result-box';
    }
  } catch(e) {
    const display = document.getElementById('agentStateDisplay');
    if (display) display.textContent = 'Erro ao carregar estado.';
    console.warn('[agentState]', e);
  }
}

// ── loadWorkerStatus: mostra painel do Worker ──
async function loadWorkerStatus() {
  try {
    const res  = await fetch('/worker/status');
    const data = await res.json();
    if (!data.success) return;

    const r = data.response || {};
    const workers = r.workers || [];
    const online  = workers.filter(w => w.online);
    const w = online[0] || workers[0] || null;

    const dot    = document.getElementById('workerDot');
    const statusT = document.getElementById('workerStatusText');
    const verTag  = document.getElementById('workerVersionTag');
    const hosEl   = document.getElementById('wHostname');
    const hbEl    = document.getElementById('wHeartbeat');
    const capsEl  = document.getElementById('wCaps');
    const dirsEl  = document.getElementById('wDirs');
    const hint    = document.getElementById('workerOfflineHint');

    if (online.length > 0 && w) {
      if (dot) dot.className = 'bridge-dot online';
      if (statusT) statusT.textContent = `Worker ONLINE (${online.length} ativo${online.length > 1 ? 's' : ''})`;
      if (verTag)  verTag.textContent = `v${w.version || '?'}`;
      if (hosEl)   hosEl.textContent  = w.hostname || '-';
      if (hbEl) {
        const hb = w.last_heartbeat ? w.last_heartbeat.replace('T',' ').slice(0,19) : '-';
        hbEl.textContent = hb;
      }
      if (capsEl) capsEl.textContent = (w.capabilities || []).join(', ') || '-';
      if (dirsEl) dirsEl.textContent = (w.allowed_dirs || []).slice(0,2).join(', ') || '—';
      if (hint) hint.style.display = 'none';
    } else {
      if (dot) dot.className = 'bridge-dot offline';
      if (statusT) statusT.textContent = 'Worker OFFLINE';
      if (verTag)  verTag.textContent = '';
      if (hosEl)   hosEl.textContent  = '—';
      if (hbEl)    hbEl.textContent   = '—';
      if (capsEl)  capsEl.textContent = '—';
      if (dirsEl)  dirsEl.textContent = '—';
      if (hint) hint.style.display = '';
    }
  } catch(e) { console.warn('[workerStatus]', e); }
}

// ── loadWorkerTasks: mostra tarefas recentes do Worker ──
async function loadWorkerTasks() {
  try {
    const res  = await fetch('/worker/tasks?limit=15');
    const data = await res.json();
    if (!data.success) return;

    const list = document.getElementById('workerTasksList');
    if (!list) return;

    const tasks = data.response?.tasks || [];
    if (tasks.length === 0) {
      list.innerHTML = '<div class="queue-empty">Sem tarefas do worker ainda.</div>';
      return;
    }

    list.innerHTML = '';
    tasks.forEach(t => {
      const item = document.createElement('div');
      item.className = 'audit-item';
      const ts = t.created_at ? t.created_at.replace('T',' ').slice(0,19) : '-';
      const statusMap = { pending:'⏳ pendente', in_progress:'🔄 executando', completed:'✅ OK', failed:'❌ falhou' };
      const statusTxt = statusMap[t.status] || t.status;
      const riskClass = t.risk === 'high' ? 'err' : t.risk === 'medium' ? 'pend' : 'ok';
      const argsStr = JSON.stringify(t.args || {}).slice(0, 50);
      item.innerHTML = `
        <span class="audit-ts">${ts}</span>
        <span class="audit-desc">${escapeHtml(t.type||'?')} · ${escapeHtml(argsStr)}</span>
        <span class="audit-result ${riskClass}">${statusTxt}</span>
        <span class="audit-decision" style="font-size:9px;color:var(--dim)">${t.task_id?.slice(-8)||''}</span>
      `;
      list.appendChild(item);
    });
  } catch(e) { console.warn('[workerTasks]', e); }
}

// ── loadAgentQueue: carrega fila de aprovações ──
async function loadAgentQueue() {
  try {
    const res  = await fetch('/agent/queue');
    const data = await res.json();
    if (!data.success) return;

    const r = data.response;
    renderQueue('pendingQueue', r.pending || [], true);
    renderQueue('autoQueue',    r.auto    || [], false);
  } catch(e) { console.warn('[queue]', e); }
}

function renderQueue(containerId, actions, requiresApproval) {
  const container = document.getElementById(containerId);
  if (!container) return;

  if (actions.length === 0) {
    container.innerHTML = '<div class="queue-empty">Nenhuma ação.</div>';
    return;
  }

  container.innerHTML = '';
  actions.forEach(action => {
    const item = document.createElement('div');
    const riskClass = action.risk || 'low';
    item.className = `queue-item risk-${riskClass}${action.already_approved ? ' approved' : ''}`;
    item.dataset.actionId = action.action_id;

    const argsStr = JSON.stringify(action.args || {}).slice(0, 80);

    item.innerHTML = `
      <div class="queue-item-head">
        <span class="risk-badge ${riskClass}">${riskClass}</span>
        <span class="queue-tool-label">${action.tool}</span>
        <span class="queue-reason">${escapeHtml(action.reason || argsStr)}</span>
        <span class="queue-chevron">▶</span>
      </div>
      <div class="queue-item-body">
        <div class="queue-preview" id="preview-${action.action_id}">Clique em prévia para carregar...</div>
        <div class="queue-actions" id="actions-${action.action_id}">
          ${buildQueueActions(action, requiresApproval)}
        </div>
      </div>
    `;

    item.querySelector('.queue-item-head').addEventListener('click', () => {
      item.classList.toggle('expanded');
      if (item.classList.contains('expanded')) {
        loadPreview(action.action_id);
      }
    });

    wireQueueButtons(item, action, requiresApproval);
    container.appendChild(item);
  });
}

function buildQueueActions(action, requiresApproval) {
  if (!requiresApproval) {
    return `<button class="qa-btn qa-exec" data-exec="${action.action_id}">▶ Executar</button>`;
  }
  if (action.already_approved) {
    return `
      <span class="qa-approved-badge">✓ Aprovada</span>
      <button class="qa-btn qa-exec" data-exec="${action.action_id}">▶ Executar agora</button>
      <button class="qa-btn qa-deny" data-deny="${action.action_id}">✕ Revogar</button>
    `;
  }
  return `
    <button class="qa-btn qa-approve" data-approve="${action.action_id}">✓ Aprovar</button>
    <button class="qa-btn qa-deny"    data-deny="${action.action_id}">✕ Negar</button>
    <button class="qa-btn qa-exec"    data-exec="${action.action_id}" style="opacity:.4;cursor:default" disabled>▶ Exec (requer aprovação)</button>
  `;
}

function wireQueueButtons(item, action, requiresApproval) {
  item.querySelectorAll('[data-approve]').forEach(btn => {
    btn.addEventListener('click', async () => {
      await approveAction(action.action_id, true);
      await loadAgentQueue();
    });
  });
  item.querySelectorAll('[data-deny]').forEach(btn => {
    btn.addEventListener('click', async () => {
      await approveAction(action.action_id, false);
      await loadAgentQueue();
    });
  });
  item.querySelectorAll('[data-exec]').forEach(btn => {
    if (btn.disabled) return;
    btn.addEventListener('click', async () => {
      await executeAction(action.action_id);
    });
  });
}

async function loadPreview(actionId) {
  const el = document.getElementById(`preview-${actionId}`);
  if (!el) return;
  try {
    const res  = await fetch(`/agent/preview/${actionId}`);
    const data = await res.json();
    if (!data.success) { el.textContent = 'Prévia indisponível.'; return; }
    const r = data.response;
    const lines = [
      `Ação:       ${r.action || '-'}`,
      `Target:     ${r.target || '-'}`,
      `Risco:      ${r.risk || '-'}`,
      `Reversível: ${r.reversible ? 'sim' : 'NÃO'}`,
      `Esperado:   ${r.expected || '-'}`,
    ];
    if (r.command) lines.push(`Comando:    ${r.command}`);
    if (r.diff) lines.push(`\nDiff:\n${r.diff}`);
    el.textContent = lines.join('\n');
  } catch(e) {
    if (el) el.textContent = `Erro ao carregar prévia: ${e.message}`;
  }
}

async function approveAction(actionId, approved) {
  try {
    const res  = await fetch('/agent/approve', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ action_id: actionId, approved }),
    });
    const data = await res.json();
    if (!data.success) {
      showToast('Erro: ' + (data.detail || 'falha na aprovação'));
      return;
    }
    showToast(approved ? `✓ Aprovada: ${actionId}` : `✕ Negada: ${actionId}`);
    await loadAuditLog();
  } catch(e) { showToast('Erro: ' + e.message); }
}

async function executeAction(actionId) {
  const resultBox = document.getElementById('agentResultBox');
  if (resultBox) { resultBox.textContent = 'Executando...'; resultBox.className = 'agent-result-box'; }

  try {
    const res  = await fetch('/agent/execute', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ action_id: actionId }),
    });
    const data = await res.json();

    if (!res.ok || !data.success) {
      const err = data.detail || data.response?.error || 'Erro na execução';
      if (resultBox) { resultBox.textContent = `ERRO: ${err}`; resultBox.className = 'agent-result-box err'; }
      showToast('Erro: ' + err);
      return;
    }

    const r = data.response;
    const lines = [
      `OK:          ${r.ok}`,
      `Action ID:   ${r.action_id}`,
      `Tool:        ${r.tool}`,
      `Stop reason: ${r.stop_reason}`,
    ];
    if (r.result && Object.keys(r.result).length > 0) {
      lines.push('', 'Resultado:', JSON.stringify(r.result, null, 2).slice(0, 800));
    }
    if (r.error) lines.push('', `Erro: ${r.error}`);

    if (resultBox) {
      resultBox.textContent = lines.join('\n');
      resultBox.className = `agent-result-box ${r.ok ? 'ok' : 'err'}`;
    }
    showToast(r.ok ? 'Ação executada!' : 'Falha na execução');

    await loadAgentState();
    await loadAgentQueue();
    await loadAuditLog();
  } catch(e) {
    if (resultBox) { resultBox.textContent = `Erro de conexão: ${e.message}`; resultBox.className = 'agent-result-box err'; }
    showToast('Erro: ' + e.message);
  }
}

// ── Plan ──
async function submitPlan() {
  const objective = document.getElementById('agentObjective')?.value.trim();
  if (!objective) { showToast('Escreva um objetivo primeiro'); return; }

  const mode = document.getElementById('agentModeSelect')?.value || 'propose';
  const btn  = document.getElementById('agentPlanBtn');
  if (btn) { btn.disabled = true; btn.textContent = '...'; }

  try {
    const target = _execTarget || 'vps';

    const res  = await fetch('/agent/plan', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({
        objective,
        mode,
        execution_target: target,
        local_target_root: target === 'local' ? _localRoot() : '',
      }),
    });
    const data = await res.json();

    if (!res.ok || !data.success) {
      showToast('Erro ao planejar: ' + (data.detail || 'falha'));
      return;
    }

    const plan = data.response;
    showToast(`Plano gerado: ${plan.proposed_actions?.length || 0} ação(ões)`);

    await loadAgentState();
    await loadAgentQueue();
  } catch(e) {
    showToast('Erro: ' + e.message);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '⬡ Planejar'; }
  }
}

// ── Audit log ──
async function loadAuditLog() {
  try {
    const res  = await fetch('/agent/audit?limit=20');
    const data = await res.json();
    if (!data.success) return;

    const list = document.getElementById('auditList');
    if (!list) return;

    const entries = data.response.entries || [];
    if (entries.length === 0) {
      list.innerHTML = '<div class="queue-empty">Sem entradas de auditoria.</div>';
      return;
    }

    list.innerHTML = '';
    entries.forEach(e => {
      const item = document.createElement('div');
      item.className = 'audit-item';

      const ts = e.ts ? e.ts.replace('T',' ').slice(0,19) : '-';
      const resultClass = e.result_ok === true ? 'ok' : e.result_ok === false ? 'err' : 'pend';
      const resultLabel = e.result_ok === true ? 'OK' : e.result_ok === false ? 'FAIL' : e.decision.toUpperCase();
      const decisionMap = { approved:'aprovado', denied:'negado', auto_executed:'auto', blocked:'bloqueado', failed:'falhou', dispatched:'despachado' };

      item.innerHTML = `
        <span class="audit-ts">${ts}</span>
        <span class="audit-desc">${escapeHtml(e.tool)} · ${escapeHtml(e.target||'').slice(0,40)}</span>
        <span class="audit-result ${resultClass}">${resultLabel}</span>
        <span class="audit-decision">${decisionMap[e.decision]||e.decision}</span>
      `;
      list.appendChild(item);
    });
  } catch(e) { console.warn('[audit]', e); }
}

// Event listeners
document.getElementById('agentPlanBtn')?.addEventListener('click', submitPlan);
document.getElementById('agentObjective')?.addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.ctrlKey) { e.preventDefault(); submitPlan(); }
});
document.getElementById('loadAgentStateBtn')?.addEventListener('click', loadAgentState);
document.getElementById('refreshQueueBtn')?.addEventListener('click', () => { loadAgentQueue(); loadAuditLog(); });
document.getElementById('refreshAuditBtn')?.addEventListener('click', loadAuditLog);
document.getElementById('refreshWorkerBtn')?.addEventListener('click', () => { loadWorkerStatus(); loadAgentState(); });
document.getElementById('refreshWorkerTasksBtn')?.addEventListener('click', loadWorkerTasks);

// Auto-refresh worker status every 15s when on agent panel
let _workerRefreshTimer = null;
function startWorkerRefresh() {
  stopWorkerRefresh();
  loadWorkerStatus();
  loadWorkerTasks();
  _workerRefreshTimer = setInterval(() => { loadWorkerStatus(); loadWorkerTasks(); }, 15000);
}
function stopWorkerRefresh() {
  if (_workerRefreshTimer) { clearInterval(_workerRefreshTimer); _workerRefreshTimer = null; }
}

/* ══════════════════════════════════════════════
   WORKSPACE SELECTOR
══════════════════════════════════════════════ */
let activeWorkspace = 'luna-agent';

async function loadWorkspaces() {
  try {
    const res  = await fetch('/workspaces');
    if (!res.ok) {
      console.warn('[workspaces] rota retornou', res.status);
      return;
    }
    const data = await res.json();
    if (!data.success) return;
    activeWorkspace = data.response.active_workspace || 'luna-agent';
    const el = document.getElementById('ui-project');
    if (el) el.innerText = activeWorkspace + ' ▾';
  } catch(e) { console.warn('[workspaces]', e); }
}

async function switchWorkspace(name) {
  try {
    await fetch('/workspace/switch', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ workspace: name }),
    });
    activeWorkspace = name;
    const el = document.getElementById('ui-project');
    if (el) el.innerText = name + ' ▾';
  } catch(e) { console.warn('[workspace/switch]', e); }
}

/* ══════════════════════════════════════════════
   EXECUTION TARGET & LOCAL BRIDGE
══════════════════════════════════════════════ */
const BRIDGE_URL = 'http://127.0.0.1:8765';
let _execTarget   = localStorage.getItem('luna_exec_target') || 'vps';
let _lastImageB64 = null;
let _bridgePollTimer = null;

function _localRoot() {
  return localStorage.getItem('luna_local_root') || '/mnt/d/luna-agent';
}

function setExecTarget(target) {
  _execTarget = target;
  localStorage.setItem('luna_exec_target', target);

  const btnVps   = document.getElementById('execBtnVps');
  const btnLocal = document.getElementById('execBtnLocal');
  const badge    = document.getElementById('screenTargetBadge');
  const capBtn   = document.getElementById('captureScreenBtn');
  const localRootInput = document.getElementById('localRootInput');

  if (btnVps)   btnVps.classList.toggle('active', target === 'vps');
  if (btnLocal) btnLocal.classList.toggle('active', target === 'local');
  if (badge)    badge.textContent = `alvo: ${target.toUpperCase()}`;
  if (capBtn)   capBtn.disabled = (target !== 'local');
  if (localRootInput) localRootInput.style.display = target === 'local' ? '' : 'none';

  if (target === 'local') {
    loadWorkerStatus();
    loadBridgeStatus();   // legacy fallback check
    startBridgePoll();
  } else {
    stopBridgePoll();
    setBridgeDot('offline');
  }
}

document.getElementById('localRootInput')?.addEventListener('change', e => {
  localStorage.setItem('luna_local_root', e.target.value);
});

function setBridgeDot(state) {
  const dot   = document.getElementById('bridgeDot');
  const label = document.getElementById('bridgeStatusLabel');
  const smBridge = document.getElementById('smBridge');
  if (dot)   dot.className = 'bridge-dot ' + state;
  if (label) label.textContent = state === 'online' ? 'bridge online' : state === 'checking' ? 'checando...' : 'bridge offline';
  if (smBridge) {
    smBridge.textContent = state;
    smBridge.style.color = state === 'online' ? '#4ade80' : state === 'checking' ? 'var(--amber)' : '#ef4444';
  }
}

async function loadBridgeStatus() {
  setBridgeDot('checking');
  // Try direct bridge first; fall back to VPS-proxied /local/health (tunnel check)
  let directOk = false;
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 3000);
    const healthRes = await fetch(`${BRIDGE_URL}/health`, { signal: ctrl.signal });
    clearTimeout(timer);
    if (healthRes.ok) {
      directOk = true;
      setBridgeDot('online');
      const ctrl2 = new AbortController();
      const timer2 = setTimeout(() => ctrl2.abort(), 3000);
      const statusRes = await fetch(`${BRIDGE_URL}/screen/status`, { signal: ctrl2.signal });
      clearTimeout(timer2);
      if (statusRes.ok) {
        const statusData = await statusRes.json();
        const r = statusData.response || {};
        if (r.last_capture) updateCaptureMetaUI(r.last_capture);
      }
    }
  } catch(e) {
    console.warn('[bridge] direct check failed:', e.message);
  }
  if (!directOk) {
    // Fallback: check via VPS proxy (confirms tunnel is working)
    try {
      const ctrl3 = new AbortController();
      const timer3 = setTimeout(() => ctrl3.abort(), 4000);
      const vpsRes = await fetch('/local/health', { signal: ctrl3.signal });
      clearTimeout(timer3);
      if (vpsRes.ok) {
        setBridgeDot('online');
        return;
      }
    } catch(e2) {
      console.warn('[bridge] vps-proxy fallback failed:', e2.message);
    }
    setBridgeDot('offline');
  }
}

function startBridgePoll() {
  stopBridgePoll();
  _bridgePollTimer = setInterval(loadBridgeStatus, 30000);
}

function stopBridgePoll() {
  if (_bridgePollTimer) { clearInterval(_bridgePollTimer); _bridgePollTimer = null; }
}

function updateCaptureMetaUI(meta) {
  const smTs   = document.getElementById('smTs');
  const smRes  = document.getElementById('smRes');
  const smSize = document.getElementById('smSize');
  const ts = meta.ts ? meta.ts.replace('T', ' ').slice(0, 19) : '—';
  if (smTs)   smTs.textContent   = ts;
  if (smRes)  smRes.textContent  = meta.width && meta.height ? `${meta.width}×${meta.height}` : '—';
  if (smSize) smSize.textContent = meta.size_kb ? `${meta.size_kb} KB` : '—';
}

async function captureScreen() {
  if (_execTarget !== 'local') return;
  const btn     = document.getElementById('captureScreenBtn');
  const img     = document.getElementById('screenPreviewImg');
  const empty   = document.getElementById('screenPreviewEmpty');
  const wrap    = document.getElementById('screenPreviewWrap');
  const overlay = document.getElementById('screenPreviewOverlay');
  const overlayTs  = document.getElementById('screenOverlayTs');
  const analyzeBtn = document.getElementById('analyzeScreenBtn');

  if (btn) { btn.disabled = true; btn.textContent = '⏳ Capturando...'; }
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 10000);
    const res = await fetch(`${BRIDGE_URL}/screen/capture`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ monitor: 1, max_width: 1280 }),
      signal: ctrl.signal,
    });
    clearTimeout(timer);
    if (!res.ok) throw new Error(`bridge retornou ${res.status}`);
    const data = await res.json();
    const r = data.response;
    _lastImageB64 = r.image_b64;

    if (img && r.image_b64) {
      img.src = `data:${r.mime || 'image/jpeg'};base64,${r.image_b64}`;
      img.style.display = 'block';
      if (empty) empty.style.display = 'none';
      if (wrap)  wrap.classList.add('has-img');
    }
    if (overlay)   overlay.style.display = 'flex';
    if (overlayTs) overlayTs.textContent = r.ts ? r.ts.replace('T', ' ').slice(0, 19) : '';
    if (analyzeBtn) analyzeBtn.style.display = 'inline-flex';
    updateCaptureMetaUI(r);
  } catch(e) {
    console.error('[captureScreen]', e);
    setBridgeDot('offline');
    showToast(`Captura falhou: ${e.message}`);
  } finally {
    if (btn) { btn.disabled = (_execTarget !== 'local'); btn.textContent = '📷 Capturar tela'; }
  }
}

async function analyzeScreen() {
  if (!_lastImageB64) return;
  const btn  = document.getElementById('analyzeScreenBtn');
  const box  = document.getElementById('screenAnalysisBox');
  const text = document.getElementById('screenAnalysisText');

  if (btn)  { btn.disabled = true; btn.textContent = '⏳ Analisando...'; }
  if (box)  box.classList.add('visible');
  if (text) text.textContent = 'Enviando para análise visual...';

  try {
    const res = await fetch('/screen/analyze', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ image_b64: _lastImageB64, mime: 'image/jpeg' }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || `erro ${res.status}`);
    if (text) text.textContent = data.response?.analysis || '(sem análise)';
  } catch(e) {
    if (text) text.textContent = `Análise falhou: ${e.message}`;
    console.error('[analyzeScreen]', e);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '🔍 Analisar'; }
  }
}

// Event listeners para botões de captura
document.getElementById('captureScreenBtn')?.addEventListener('click', captureScreen);
document.getElementById('analyzeScreenBtn')?.addEventListener('click', analyzeScreen);

// Inicializar localRootInput com valor salvo
(function() {
  const inp = document.getElementById('localRootInput');
  if (inp) inp.value = _localRoot();
})();

// Inicializar estado do target (restaura da sessão anterior)
setExecTarget(_execTarget);

// Carregar workspaces ao iniciar
loadWorkspaces();

</script>
</body>
</html>
    