      p.classList.add('active');
    }
  };
});

/* ══════════════════════════════════════════════
   PARTICLE BACKGROUND
══════════════════════════════════════════════ */
(function () {
  const canvas = document.getElementById('bg-canvas');
  const ctx    = canvas.getContext('2d');
  let W, H, stars = [];
  const N = 140;

  function resize() {
    W = canvas.width  = innerWidth;
    H = canvas.height = innerHeight;
  }

  function init() {
    stars = Array.from({ length: N }, () => ({
      x:  Math.random() * W,
      y:  Math.random() * H,
      r:  Math.random() * 1.15 + 0.2,
      a:  Math.random(),
      da: (Math.random() * 0.0022 + 0.0007) * (Math.random() < .5 ? 1 : -1),
      vx: (Math.random() - .5) * 0.065,
      vy: (Math.random() - .5) * 0.065,
      cyan: Math.random() < 0.18,
    }));
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    for (const s of stars) {
      s.x += s.vx; s.y += s.vy; s.a += s.da;
      if (s.a > 1)  s.da = -Math.abs(s.da);
      if (s.a < 0)  s.da =  Math.abs(s.da);
      if (s.x < 0)  s.x  = W;
      if (s.x > W)  s.x  = 0;
      if (s.y < 0)  s.y  = H;
      if (s.y > H)  s.y  = 0;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = s.cyan
        ? `rgba(52,188,255,${s.a * .62})`
        : `rgba(150,195,255,${s.a * .42})`;
      ctx.fill();
    }
    requestAnimationFrame(draw);
  }

  resize(); init(); draw();
  window.addEventListener('resize', () => { resize(); init(); });
})();

/* ══════════════════════════════════════════════
   CURSOR AURA
══════════════════════════════════════════════ */
const aura = document.getElementById('cursor-aura');
document.addEventListener('mousemove', e => {
