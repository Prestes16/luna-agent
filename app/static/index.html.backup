                <div>
                  <div class="upload-zone" id="maskUploadZone">
                    <input type="file" id="maskImageInput" accept="image/png">
                    <div class="upload-icon">🎭</div>
                    <div class="upload-label">Máscara (opcional)</div>
                    <div class="upload-hint">PNG com área transparente a editar</div>
                    <div class="upload-name" id="maskImageName"></div>
                  </div>
                </div>
              </div>
              <textarea class="img-prompt" id="editPrompt" rows="2"
                placeholder="O que deve aparecer na área editada? Descreva com detalhe..."></textarea>
              <div class="img-prompt-wrap stability-only" id="editNegWrap">
                <textarea class="img-prompt" id="editNegativePrompt" rows="1"
                  placeholder="Negative prompt (Stability)..."></textarea>
              </div>
              <div class="img-controls openai-only" id="editOpenAIControls">
                <div class="img-ctrl">
                  <label>Tamanho</label>
                  <select id="editSize">
                    <option value="1024x1024">1024 × 1024</option>
                    <option value="512x512">512 × 512</option>
                    <option value="256x256">256 × 256</option>
                  </select>
                </div>
              </div>
              <div style="display:flex;justify-content:flex-end">
                <button class="img-generate-btn" id="imgEditBtn">
                  <span class="img-spinner"></span>
                  <span class="img-btn-label">✎ Editar imagem</span>
                </button>
              </div>
