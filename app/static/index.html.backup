            <div class="img-form">
              <div class="img-edit-grid">
                <div>
                  <div class="upload-zone" id="editUploadZone">
                    <input type="file" id="editImageInput" accept="image/png,image/jpeg,image/webp">
                    <div class="upload-icon">🖼</div>
                    <div class="upload-label">Imagem para editar</div>
